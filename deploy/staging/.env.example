# Copy to deploy/staging/.env (gitignored) and fill in. Testnet and synthetic data only: never a mainnet seed,
# never real credentials of a production account. Every value without a default is required: compose refuses to
# start without it.

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Testnet-only MULTISIG seed (generate a fresh one for staging; never reuse one that ever held real funds).
MULTISIG_SEED=
# Comma-separated arbiter user ids that exist in this staging database.
TRUSTED_ARBITRATORS=

# Production requires an S3-compatible evidence store (local-fs is refused at boot). Provider is pending.
# For an S3-compatible service set the endpoint and, if it needs it, path-style addressing.
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_REGION=auto
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_FORCE_PATH_STYLE=false

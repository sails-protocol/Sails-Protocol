# Sails Node — server configuration (copied to $SAILS_NODE_HOME/secrets/server.env by
# `sails-node init`; DATABASE_URL lives in secrets/db.env and is generated for you).
# This file is read by the server container at start. It is never baked into an image.
# Mode 0600. Do not commit your filled copy.
#
# Production refuses to boot on unsafe values (docs/DEPLOYMENT.md): the settings below are the
# required, fail-closed ones.

REDIS_URL=redis://redis:6379

# Bitcoin network of the MULTISIG escrow rail: mainnet | testnet | regtest (required).
MULTISIG_NETWORK=regtest

# Real custody must be explicit.
MOCK_ESCROW=false
MOCK_SETTLEMENT=false
ENFORCE_CAPABILITIES=true

# Evidence storage must be an S3-COMPATIBLE bucket in production ("local-fs" is refused: a
# container restart would lose evidence). Defaults target the bundled SeaweedFS store
# (COMPOSE_PROFILES=evidence-store; the bucket is created for you); for your own S3-compatible
# store change the endpoint, bucket and credentials.
EVIDENCE_PROVIDER=s3
EVIDENCE_S3_ENDPOINT=http://seaweedfs:8333
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_BUCKET=sails-evidence
EVIDENCE_S3_FORCE_PATH_STYLE=true

# Operator-supplied secrets for real custody (MULTISIG_SEED, arbiter identity, ...): see
# docs/DEPLOYMENT.md sections 8.3 and 7 for what a real deployment needs. None of them is
# generated, provided or held by Satsails.

# External services the node talks to (all configurable; none is operated by Satsails).
# Defaults point at public testnet endpoints; set your own for production:
#   MULTISIG_EXPLORER_API_URL   Esplora/mempool-compatible Bitcoin explorer API
#   ARKADE_ASP_URL, ARKADE_EXPLORER_API_URL   only if the Arkade rail is used
#   WDK_RPC_URL, SAFE_GUARD_EVM_RPC_URL       only if an EVM rail is used

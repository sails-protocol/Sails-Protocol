generator client {
  provider = "prisma-client-js"
}

// Prisma 7 (Dependabot major-version bump, 2026-07-19): schema-level
// `url = env("DATABASE_URL")` is no longer supported — connection config
// moves to prisma.config.ts (CLI/migrate) and an explicit driver adapter
// passed to `new PrismaClient({ adapter })` (runtime, common/database/index.ts).
// See https://pris.ly/d/config-datasource and https://pris.ly/d/prisma7-client-config.
datasource db {
  provider = "postgresql"
}

enum AssetType {
  BTC
  USDT_ERC20
  USDT_TRC20
  USDT_LIQUID
  USDT_LIGHTNING
  LN_BTC
  LIQUID_BTC
  SPARK
  STACKS
  RSK_BTC
}

enum TradeSide {
  BUY
  SELL
}

enum OfferStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TradeStatus {
  PENDING
  ACTIVE
  COMPLETED
  DISPUTED
  CANCELLED
}

enum EscrowType {
  MULTISIG
  LIGHTNING_HODL
  LIQUID_COVENANT
  WDK_USDT_EVM // real @tetherto/wdk-wallet-evm USDT (ERC-20) settlement — see wdk-settlement.provider.ts
  SAFE_GUARD_EVM // RFC-020 — Safe Transaction Guard + ERC-4337, KMS-backed arbiter co-signer — see safe-guard-evm.provider.ts
  MOCK
}

enum EscrowStatus {
  CREATED
  FUNDS_LOCKED
  PAYMENT_PENDING
  COMPLETED
  DISPUTED
  REFUNDED
  // RFC-021 D9 (2026-08-02) — §1.9's third dispute-ruling option
  // (DisputeRuling.SPLIT) finally has a real settlement action for the
  // escrow types that can actually represent a partial payout (MOCK,
  // WDK_USDT_EVM, MULTISIG). Only reachable from DISPUTED — see
  // escrow.service.ts's VALID_TRANSITIONS.
  SPLIT
  // Missão 11 Fase 7.3.3 §B — a real, durable, non-terminal state: this
  // escrow's timelock genuinely expired while still FUNDS_LOCKED, and its
  // settlement rail cannot be auto-refunded cooperatively (client-held
  // buyer/seller keys — see escrow.service.ts's sweepExpiredEscrows()).
  // Reached ONLY from FUNDS_LOCKED, by the existing timelock sweeper —
  // system OBSERVES and RECORDS the expiry fact, never signs anything,
  // never impersonates a participant, never moves funds. From here, the
  // authorized seller (the only party with actual locked collateral at
  // stake in this state — see this phase's own authority-matrix report)
  // may initiate the existing dispute mechanism
  // (dispute.service.ts's initiateExpiryRecovery(), a thin, guided call
  // into the pre-existing raiseDispute()), or either party may still
  // cooperatively refund if the counterparty returns — see
  // escrow-lifecycle.ts's VALID_TRANSITIONS for exactly which onward
  // transitions this permits. Purely additive: no existing escrow's
  // status/meaning changes, and nothing retroactively reinterprets a
  // historical FUNDS_LOCKED/REFUNDED escrow's own history.
  EXPIRED
}

enum PaymentMethod {
  PIX
  TED
  BANK_TRANSFER
  CRYPTO_DIRECT
  LIGHTNING_DIRECT
  CASH
  OTHER
}

// moduleId/protocolVersion below: mandated by MASTER_COORDINATION.md so that
// future modules (Sails OpenFinance, Sails OpenAgents) can coexist in the
// same tables without ambiguity about which module owns which row, and so
// the protocol version an entity was created under is always traceable.

model User {
  id                     String   @id @default(uuid())
  publicKey              String   @unique
  displayName            String?
  peerId                 String?  @unique
  reputationScore        Float    @default(0)
  totalTrades            Int      @default(0)
  disputeCount           Int      @default(0)
  totalVolumeBtc         Decimal  @default(0) @db.Decimal(24, 8)
  // RFC-021 D4, Phase 3 — the real cost-to-fabricate-reputation floor
  // (Yuri's own mechanism, formalized): sum of Escrow.feeCharged across
  // every trade this participant has completed (settlement.escrow.released
  // handler, common/events/handlers.ts). A worst-case Sybil analysis can
  // treat all of a participant's reputation as fabricated, but this
  // number is still a real, non-fabricatable lower bound on what that
  // fabrication cost in protocol fees — see RFC-021 D4.
  cumulativeFeesObserved Decimal  @default(0) @db.Decimal(24, 8)
  verified               Boolean  @default(false)
  moduleId               String   @default("openidentity")
  protocolVersion        String   @default("0.1")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  offers             Offer[]
  buyerTrades        Trade[]           @relation("BuyerTrades")
  sellerTrades       Trade[]           @relation("SellerTrades")
  sentMessages       Message[]
  reputationGiven    ReputationEvent[] @relation("RaterEvents")
  reputationReceived ReputationEvent[] @relation("RatedEvents")
  arbiterProfile     ArbiterProfile? // RFC-021 — present only if this participant has registered as an arbiter candidate
  paymentAccounts    PaymentAccount[] // RFC-021 D5 — zero or more linked payment rails, each with its own trust ramp
  vouchesGiven       Vouch[]           @relation("VouchesGiven") // RFC-021 D7 — peer vouches this participant has extended to newcomers
  vouchesReceived    Vouch[]           @relation("VouchesReceived") // RFC-021 D7 — peer vouches this participant has received
  payoutAddresses    PayoutAddress[] // BACKLOG.md's own "Participant payout address" gap, closed 2026-08-04

  @@index([reputationScore]) // P2: performance for leaderboard queries
  @@map("users")
}

model Offer {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  asset           AssetType
  side            TradeSide
  priceUsd        Decimal       @db.Decimal(24, 8)
  priceBrl        Decimal?      @db.Decimal(24, 8)
  minAmount       Decimal       @db.Decimal(24, 8)
  maxAmount       Decimal       @db.Decimal(24, 8)
  paymentMethod   PaymentMethod
  paymentDetails  String?
  status          OfferStatus   @default(ACTIVE)
  network         String?
  description     String?
  moduleId        String        @default("openliquidity")
  protocolVersion String        @default("0.1")
  intentType      String?
  // RFC-018 (rfcs/RFC-018-intent-as-canonical-trade-entry-point.md) —
  // the real Intent row this Offer was created from (createOffer() ->
  // intentEngine.create()). Nullable: pre-migration Offer rows have no
  // Intent behind them and remain fully valid, same backward-compatible
  // pattern RFC-008 used for entryHash/prevHash. Postgres's own UNIQUE
  // semantics allow any number of `NULL` rows alongside a real
  // constraint on every non-null value, so this is fully compatible
  // with those pre-migration rows — never a reason to avoid enforcing
  // uniqueness on the ones that DO have a real Intent behind them.
  //
  // CROSS-LAYER-SEMANTIC-CORRECTIVE-1-R5 (2026-09-14) — `@unique` added.
  // This is a genuine domain-truth check, not a convenience decision:
  // every Offer-creating code path (`createOffer()`) creates a BRAND
  // NEW Intent for a genuinely new logical attempt — the ONLY way two
  // Offer rows could ever end up pointing at the SAME Intent is via
  // `persistOffer()`'s own idempotent-retry reconciliation
  // (`IntentRepository.findByIdempotencyClaimId()`, R4), which by
  // definition means "the same logical `createOffer` attempt," not two
  // independently-intended offers. "In practice one Intent maps to at
  // most one Offer" (comment below, on `Intent.offers`) was already
  // true by construction before this constraint — this makes Postgres
  // itself enforce what was already always true, closing the Offer
  // INSERT's own unknown-outcome window: `persistOffer()` now recovers
  // an existing Offer for a canonical Intent by a direct, unique lookup
  // (`prisma.offer.findUnique({ where: { intentId } })`), the exact same
  // "insert-as-lock, catch P2002, look up the winner" idiom this whole
  // idempotency mechanism already uses, needing no separate Offer-side
  // idempotency-claim column at all — `intentId` itself is already a
  // 1:1 correlation key for "this logical attempt" once R4 made Intent
  // itself uniquely tied to the idempotency claim.
  intentId        String?       @unique
  intent          Intent?       @relation(fields: [intentId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trades Trade[]

  @@index([asset, side, status])
  @@index([userId])
  @@map("offers")
}

enum OfferEnvelopeStatus {
  ACTIVE
  CANCELLED
}

// ADR-001 Day-0 Multi-Operator Sails Network, Implementation Sequence
// step (a) "Portable Signed Offers" (docs/adr/ADR-001-day0-multi-operator-network.md
// §3/§21, docs/PORTABLE_SIGNED_OFFERS_EVIDENCE.md). A signed, portable,
// independently-verifiable economic advertisement — deliberately
// separate from `Offer` above, which remains this node's own local
// OpenLiquidity bookkeeping, completely untouched by this model (zero
// breaking change to any existing route, service, or SDK surface).
//
// Append-only: one row per distinct, independently-verified signed fact
// ever received — never updated or overwritten
// (`offer-envelope-repository.ts`'s `ingest()` only ever creates new
// rows). Rows are scoped to **offer identity**, the pair
// `(ownerPublicKey, logicalOfferId)` — never a bare `logicalOfferId`,
// which is only ever creator-local and does not by itself name a unique
// offer (ADR-001 §3, Property H). Multiple distinct rows MAY legitimately
// share the identical `(ownerPublicKey, logicalOfferId, revision)` when
// the owner equivocates (signs two different facts at the same
// revision) — `contentDigest` (a hash of the canonical content,
// excluding `signature`) is what distinguishes genuinely distinct signed
// facts from a mere resend of an already-known one (Property O); `revision`
// itself determines ordering only, never deduplication (Property N).
// `getLatest()` determines the CURRENT economic state by finding the
// highest `revision` for the full offer identity and, if more than one
// distinct fact exists at that revision, fails CLOSED and reports
// `EQUIVOCATED` rather than picking one arbitrarily (Property J). This
// table is a local, non-authoritative cache of independently-verified
// facts — not itself protocol truth. Any conformant node re-derives the
// exact same accept/reject verdict from the same raw envelope fields
// (`offer-envelope.ts`'s `verifyOfferEnvelope()`) — this row never
// stores a bare "trusted" boolean; `signature` is always the real,
// re-verifiable Ed25519 signature, not a cached verdict.
model OfferEnvelope {
  id             String              @id @default(uuid())
  logicalOfferId String
  ownerPublicKey String
  asset          AssetType
  side           TradeSide
  priceUsd       Decimal             @db.Decimal(24, 8)
  minAmount      Decimal             @db.Decimal(24, 8)
  maxAmount      Decimal             @db.Decimal(24, 8)
  paymentMethod  PaymentMethod
  // Owner-chosen per offer identity (ownerPublicKey + logicalOfferId,
  // Property H) — determines CURRENT-STATE ordering only
  // (`OfferEnvelopeRepository.getLatest()` selects the highest
  // `revision`'s row(s) as current). CTO Gate correction (2026-09-09,
  // Sixth Pass, Property P): `revision` does NOT determine what gets
  // STORED — a genuinely new signed fact at a revision lower than one
  // already stored is still retained as historical/equivocation
  // evidence, never discarded as "stale" (Option B, see
  // `docs/PORTABLE_SIGNED_OFFERS_EVIDENCE.md`'s Sixth Pass section for
  // the full property-vs-mechanism evaluation). Two DIFFERENT rows may
  // legitimately share the same (ownerPublicKey, logicalOfferId,
  // revision) — that is owner equivocation (Property J), not a schema
  // bug.
  revision       Int
  // Owner-supplied, advisory only — never used for cross-node ordering
  // (that's `revision`'s job, precisely because wall-clock time isn't
  // trusted across independently-operated nodes, ADR-001 §3).
  createdAt      DateTime
  revisedAt      DateTime
  // Self-enforcing: any verifier checks this against its own clock:
  // no action or central authority is needed to "expire" an offer
  // (ADR-001 §2/§3).
  expiresAt      DateTime
  // CANCELLED is a signed tombstone at a higher revision, not a row
  // deletion — cancellation is portable via the exact same
  // signature/revision mechanism as any other update (ADR-001 §3).
  status         OfferEnvelopeStatus @default(ACTIVE)
  // Ed25519 signature hex, over the sha256 digest of this envelope's
  // own canonical serialization (`hashOfferEnvelope()`) — verifiable by
  // any party holding `ownerPublicKey`, independent of this node's own
  // database integrity.
  signature      String
  // CTO Gate correction (2026-09-09, Sixth Pass, Property O): a
  // content-derived identity for this signed fact, independent of
  // `signature`. Confirmed directly (a controlled test against the real
  // `tweetnacl` verifier, not a guess): Ed25519 signatures are
  // malleable — given one valid signature (R, S) over a message, a
  // SECOND, byte-different signature (R, S + L, where L is the Ed25519
  // group order) verifies successfully against the IDENTICAL message
  // and public key, with NO knowledge of the secret key required.
  // `signature` is therefore NOT a sound identity for deduplication or
  // equivocation detection — a mere observer (not even the offer's
  // owner) could otherwise manufacture an apparently-new "conflicting"
  // signature over content that was never actually double-signed,
  // falsely triggering EQUIVOCATED (a fail-closed, economically-inert
  // state) as a griefing vector. `contentDigest` is `hashOfferEnvelope()`'s
  // sha256 hex digest of the canonical serialization — a pure function
  // of the signed CONTENT fields only, excluding `signature` itself —
  // and is what `ingest()`/`getLatest()` now use to distinguish "the
  // same fact, differently encoded" (idempotent) from "a genuinely
  // different signed fact" (equivocation). `signature` remains stored
  // in full and is still what every verification re-checks — it is
  // demoted from "identity" to "authorization evidence," not removed.
  contentDigest  String
  // Local bookkeeping only — when THIS node first verified and stored
  // this envelope. Never protocol truth, never used in verification.
  receivedAt     DateTime            @default(now())
  moduleId       String              @default("openliquidity")
  protocolVersion String             @default("0.1")

  // CTO Gate correction (2026-09-09), Property H: the economic offer
  // identity is the PAIR (ownerPublicKey, logicalOfferId), never
  // `logicalOfferId` alone. `logicalOfferId` is only ever creator-local
  // — two different owners choosing the identical string are two
  // completely distinct economic objects, not competing claims over
  // one. Revision uniqueness (and therefore current-state selection,
  // §5) is scoped to the owner+logicalOfferId pair, so two owners can
  // never race over, block, or supersede each other's offer regardless
  // of which one this node observes first.
  //
  // CTO Gate correction (2026-09-09), Property J/O: `contentDigest` —
  // not `signature` (Property O found signature unsound for this,
  // above) — is part of this uniqueness key, not just the three
  // identity/ordering fields above. This is deliberate, not an
  // oversight — it is what makes owner EQUIVOCATION observable rather
  // than silently discarded: if the same owner signs two genuinely
  // different envelopes at the identical (ownerPublicKey,
  // logicalOfferId, revision) — a real, if adversarial, possibility
  // this schema does not prevent at the crypto layer — both are
  // durably stored as two distinct rows. A uniqueness constraint on the
  // three identity/ordering columns ALONE would silently make "the
  // second conflicting fact cannot be stored" into "the second
  // conflicting fact did not exist" — exactly the failure mode this
  // correction closes. This same constraint also closes Property M
  // (concurrent identical-fact ingestion): `ingest()` relies on this
  // constraint firing atomically at the database level — not a racy
  // application-level pre-check — to make concurrent resends of the
  // identical fact idempotent rather than double-inserted or
  // exception-leaking. `OfferEnvelopeRepository.getLatest()` is what
  // detects and surfaces conflicting content as EQUIVOCATED; this table
  // itself makes no attempt to pick a winner.
  // Named explicitly (`map:`) — Prisma's auto-generated name for this
  // four-column constraint exceeds Postgres's 63-byte identifier limit
  // (NAMEDATALEN) and would be silently truncated, risking a name
  // Prisma's own migration tooling doesn't recognize.
  @@unique([ownerPublicKey, logicalOfferId, revision, contentDigest], map: "offer_envelopes_identity_revision_digest_key")
  @@index([logicalOfferId])
  @@index([ownerPublicKey])
  @@map("offer_envelopes")
}

model Trade {
  id              String      @id @default(uuid())
  offerId         String
  offer           Offer       @relation(fields: [offerId], references: [id])
  buyerId         String
  buyer           User        @relation("BuyerTrades", fields: [buyerId], references: [id])
  sellerId        String
  seller          User        @relation("SellerTrades", fields: [sellerId], references: [id])
  asset           AssetType
  amount          Decimal     @db.Decimal(24, 8)
  priceUsd        Decimal     @db.Decimal(24, 8)
  totalUsd        Decimal     @db.Decimal(24, 8)
  status          TradeStatus @default(PENDING)
  escrowId        String?     @unique
  escrow          Escrow?
  network         String?
  moduleId        String      @default("openp2p")
  protocolVersion String      @default("0.1")
  intentType      String      @default("TradeIntent")
  // RFC-018 — copied from the accepted Offer's intentId at trade
  // creation (createTrade()). Nullable, same rationale as Offer.intentId
  // above.
  intentId        String?
  intent          Intent?     @relation(fields: [intentId], references: [id])
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  messages         Message[]
  reputationEvents ReputationEvent[]
  disputes         Dispute[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("trades")
}

model Escrow {
  id                                    String            @id @default(uuid())
  tradeId                               String            @unique
  trade                                 Trade             @relation(fields: [tradeId], references: [id])
  type                                  EscrowType        @default(MOCK)
  status                                EscrowStatus      @default(CREATED)
  lockedAmount                          Decimal           @db.Decimal(24, 8)
  asset                                 AssetType
  network                               String?
  multisigAddr                          String?
  redeemScript                          String?
  txLockId                              String?
  // Missão 10 (2026-08-19), additive — Bitcoin identifies a UTXO by
  // outpoint (txid:vout), not txid alone. txLockId's own meaning is
  // UNCHANGED (still the bare funding txid, exactly as before) — this is
  // a new, separate, nullable column, not a repurposing of an existing
  // one. Null for every escrow that locked funds before this migration
  // (including the real Missão 09 mainnet escrow) — those rows remain
  // fully readable; multisig.provider.ts's buildUnsignedSpend() falls
  // back to the pre-existing txid-only match only when this is null. Set
  // atomically alongside txLockId for every new lock from this point on.
  // The @@unique([txLockId, txLockVout]) below relies on Postgres's own
  // default NULLS DISTINCT behavior for a two-column unique constraint —
  // verified directly against a real Postgres instance (Missão 10's own
  // upgrade-proof), not assumed from documentation: a row with either
  // column NULL never collides with another NULL row, so legacy rows
  // (txLockVout IS NULL) are completely unaffected, while two new rows
  // that ever tried to claim the identical outpoint (both columns
  // non-null and equal) are rejected by the database itself, not just an
  // application-level check-then-write.
  txLockVout                            Int?
  txReleaseId                           String?
  timelockHours                         Int               @default(24)
  // RFC-021 Phase 0 — real fee collection (PROTOCOL_ECONOMY.md §6.2).
  // Nullable, not defaulted to 0: null means "no fee was computed for
  // this escrow" (protocolFeeRate was 0 at release time, or this escrow
  // predates Phase 0), vs. 0 meaning "a fee was computed and it rounded
  // to zero" — the two are different facts worth being able to tell
  // apart later. Only ever set on release (PROTOCOL_ECONOMY.md §3: "The
  // Protocol Fee only ever attaches to a completed Settlement") — never
  // on refund.
  feeCharged                            Decimal?          @db.Decimal(24, 8)
  // Missão 11 Fase 2.2 — Protocol Fee POLICY snapshot capability
  // (economic-accounting foundation only; feeCharged/FeeDistribution above
  // remain the sole LIVE fee mechanism, unchanged). Nullable: null means
  // either (a) this escrow predates Fee Policy v1 entirely — legacy,
  // including the real Missão 09 mainnet escrow, NEVER backfilled — or
  // (b) no FeePolicyVersion is PUBLISHED for this escrow's rail. Both cases
  // behave identically to today. This snapshot is deliberately NOT written
  // by createEscrow() in this pass — see escrow-fee-snapshot.service.ts:
  // the capability exists and is tested in isolation; no real settlement
  // flow calls it yet, and no "default" policy is silently assumed.
  // snapshotProtocolFeeRate/snapshotPayerModel/snapshotEconomicBasis are a
  // deliberate, small, defense-in-depth duplication of the three
  // most decision-relevant fields from feePolicyVersionId's own target row
  // (Missão 11 Fase 2.1 §5) — the full policy (bucket splits, small-trade
  // rule) stays reference-only. Once non-null, a migration-level trigger
  // (see <timestamp>_add_fee_policy_versioning_foundation/migration.sql)
  // makes these four columns as a group immutable, mirroring
  // FeePolicyVersion's own economic-column immutability below.
  // onDelete: Restrict is explicit and load-bearing here — Prisma's own
  // default for an OPTIONAL scalar relation is SET NULL, which would let a
  // FeePolicyVersion be deleted out from under an Escrow that has already
  // snapshotted it (silently detaching a settled economic snapshot from its
  // policy, exactly the kind of silent reinterpretation this design exists
  // to prevent). Confirmed by generating the migration once without this
  // and inspecting the real SQL Prisma produced (Missão 11 Fase 2.2) —
  // caught before applying, not assumed correct by default.
  feePolicyVersionId                    String?
  feePolicyVersion                      FeePolicyVersion? @relation(fields: [feePolicyVersionId], references: [id], onDelete: Restrict)
  snapshotProtocolFeeRate               Decimal?          @db.Decimal(24, 8)
  snapshotPayerModel                    FeePayerModel?
  snapshotEconomicBasis                 FeeEconomicBasis?
  // Missão 11 Fase 4.1 §1/§3 — the FROZEN collection destination and
  // pre-funding-waiver decision, computed ONCE at policy-snapshot time
  // (escrow-fee-snapshot.service.ts's computeSnapshotFields(), before the
  // seller ever funds anything) and never re-derived from live config
  // afterward. snapshotFeeCollectionAddress is the exact destination the
  // required-funding amount (R) was quoted against — construction later
  // (multisig.provider.ts) reads this frozen value, never
  // config.settlement.protocolFeeCollectionAddress directly, so a live
  // config change after this escrow was created can never redirect its
  // fee. snapshotFeeCollectionWaivedPreFunding distinguishes "the policy
  // rate is genuinely 0" (this stays false) from "the rate is nonzero but
  // the maximum possible fee was already known, before funding, to be
  // uncollectible against the frozen destination" (this is true, and
  // Fmax=0/R=T for this escrow specifically) — deliberately NOT inferred
  // from Fmax=0 alone, which would destroy that distinction (Fase 4.1 §5).
  // Both are part of the SAME immutable-once-set group as the four
  // columns above (see escrows_enforce_fee_snapshot_immutability(),
  // extended in this same migration).
  snapshotFeeCollectionAddress          String?
  snapshotFeeCollectionWaivedPreFunding Boolean?
  // Missão 11 Fase 4 §B/C — purely observational audit data, NOT the source
  // of truth for transaction construction (that remains the real chain/
  // explorer lookup, unchanged — Missão 10's own outpoint-exact selection).
  // Populated only for policy-aware escrows, at lockFunds() success time,
  // with the actual value the provider observed funding the escrow (under
  // exact-funding enforcement this always equals requiredFundingAmount in
  // the success case — recorded anyway so reconciliation can flag a
  // divergence without a live chain call, per Fase 3.3's own finding that
  // the actually-funded value was never persisted anywhere before this).
  // Legacy escrows (feePolicyVersionId NULL) never populate this — stays
  // NULL forever for them, unchanged behavior.
  fundedAmount                          Decimal?          @db.Decimal(24, 8)
  moduleId                              String            @default("opensettlement")
  protocolVersion                       String            @default("0.1")
  lockedAt                              DateTime?
  expiresAt                             DateTime?
  releasedAt                            DateTime?
  createdAt                             DateTime          @default(now())
  updatedAt                             DateTime          @updatedAt

  events             EscrowEvent[]
  disputes           Dispute[]
  feeDistribution    FeeDistribution?
  feeObligation      FeeObligation?
  // Missão 07.6.3 (R3) — back-relations for the three FKs that already
  // existed at the database level (first migration) but weren't
  // declared here. releaseApprovals/participantKeys are one-to-many
  // (each has its own @@unique([escrowId, ...]) allowing up to one row
  // per role/approver); pendingTransaction is one-to-one, matching
  // EscrowPendingTransaction.escrowId's own @unique.
  releaseApprovals   EscrowReleaseApproval[]
  participantKeys    EscrowParticipantKey[]
  pendingTransaction EscrowPendingTransaction?
  // Missão 11 Fase 9.1 §1 — the durable funding-evidence trail (see that
  // model's own header comment).
  fundingEvidence    EscrowFundingEvidence[]
  // Sails Core Implementation Program M9-F — the durable release-leg
  // reorg-evidence trail (see that model's own header comment).
  releaseEvidence    EscrowReleaseEvidence[]
  // Bounded Remediation (WDK Fund-Moving Safety, 2026-09-08) — WDK_USDT_EVM's
  // durable pre-submission execution-boundary truth (see that model's own
  // header comment). Empty for every non-WDK_USDT_EVM escrow.
  wdkTransferAttempts WdkTransferAttempt[]
  // Issue #240 — LIGHTNING_HODL/SAFE_GUARD_EVM's own durable finalize-submission evidence (see that
  // model's own header comment). At most one row (escrowId is @unique there), empty for every other type.
  signatureCollectionFinalizationAttempt SignatureCollectionFinalizationAttempt?

  // Missão 10 — cross-escrow double-claim protection for a funding
  // outpoint. Deliberately a plain (non-partial) unique constraint: see
  // txLockVout's own comment above for why Postgres's default
  // NULLS DISTINCT behavior already gives exactly the wanted semantics
  // (legacy null-vout rows never collide; two genuinely identical
  // non-null outpoints do) without needing a filtered index Prisma's own
  // schema language can't express — keeps prisma migrate diff / this
  // project's db:completeness-check honest (schema and DB agree exactly).
  @@unique([txLockId, txLockVout])
  // DB_AUDIT_REPORT.md / RELATORIO_PERFORMANCE.md, closed 2026-08-08 —
  // sweepExpiredEscrows() (escrow.service.ts) filters by exactly this
  // pair; with zero indexes on this table it was a full table scan on
  // every sweep interval tick.
  @@index([status, expiresAt])
  @@map("escrows")
}

// RFC-021 Phase 0 — persists the 40/30/20/10 split PROTOCOL_ECONOMY.md
// §6.2 already documents, per fee actually charged. Real rows, not a
// computed-and-discarded split, because RFC-021 D1 (arbiter
// monetization) and D4 (cost-to-fabricate-reputation floor) both need
// to query "how much fee has this account/pool actually generated" —
// see docs/rfcs/RFC-021-market-based-arbitration-and-payment-trust.md.
model FeeDistribution {
  id                     String    @id @default(uuid())
  escrowId               String    @unique
  escrow                 Escrow    @relation(fields: [escrowId], references: [id])
  totalFee               Decimal   @db.Decimal(24, 8)
  asset                  AssetType
  nodeOperatorShare      Decimal   @db.Decimal(24, 8) // 30%
  treasuryShare          Decimal   @db.Decimal(24, 8) // 25%
  walletRebateShare      Decimal   @db.Decimal(24, 8) // 35%
  arbitratorReserveShare Decimal   @db.Decimal(24, 8) // 10%
  moduleId               String    @default("opensettlement")
  protocolVersion        String    @default("0.1")
  createdAt              DateTime  @default(now())

  @@map("fee_distributions")
}

// ─── Missão 11 — Protocol Fee Economic Accounting Foundation ───────────────
// Fase 2.2 (2026-08-21), CTO-authorized STRUCTURAL FOUNDATION ONLY.
//
// This block adds the capability to represent and validate a versioned
// Protocol Fee policy and a per-escrow economic snapshot/obligation. It does
// NOT activate real fee collection, does NOT change any settlement amount,
// does NOT add a Bitcoin/EVM/Lightning fee output or distribution transfer,
// and does NOT choose any real economic parameter (rate, bucket split,
// confirmation depth) — every FeePolicyVersion this pass's own tests create
// is an explicitly-labeled fixture, never a production value.
// config.settlement.protocolFeeRate and chargeProtocolFee() (RFC-021 Phase 0,
// escrow-lifecycle.ts) are UNCHANGED and remain the ONLY live fee mechanism
// until a future, separately-authorized phase wires this foundation into a
// real settlement flow. See Missão 11 Fase 1/1.1/1.2/2/2.1 for the full
// design rationale this implements.
enum FeePolicyStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// Only one payer model exists today (CTO decision, Fase 1.2 §1: seller pays /
// deduction-from-settlement) — modeled as an enum, not a boolean, so a future
// model doesn't require a breaking rename.
enum FeePayerModel {
  SELLER_PAYS
}

enum FeeEconomicBasis {
  SELLER_DELIVERED_VALUE
}

// Fase 2.1 §4: a stable, essentially-permanent economic fact, deliberately
// immune to anything that happens on-chain afterward (reorg/RBF/drop never
// touch this — see FeeCollectionStatus below for that lifecycle).
enum FeeEconomicDetermination {
  OWED
  NOT_APPLICABLE
}

// Fase 2.1 §5: the collection/evidence attempt lifecycle. Only meaningful
// when FeeObligation.economicDetermination = OWED — a NOT_APPLICABLE
// obligation has collectionStatus = null and deliberately no lifecycle at
// all (Fase 2.2 §6's own instruction: "NOT_APPLICABLE não deve fingir ter
// collection lifecycle"). UNCOLLECTIBLE_BYPASSED is reachable primarily on
// client-held-key rails (MULTISIG, LIGHTNING_HODL) where buyer+seller hold
// sufficient quorum to settle outside any Sails-constructed transaction
// (Fase 1.1's proven enforcement ceiling) — not expected on server-custodial
// rails (WDK_USDT_EVM) or contract-enforced rails (SAFE_GUARD_EVM).
enum FeeCollectionStatus {
  PENDING_COLLECTION
  IN_PROGRESS
  WAIVED
  UNCOLLECTIBLE_BYPASSED
  COLLECTED
  DISTRIBUTED
}

enum FeeCollectionEvidenceKind {
  BROADCAST
  CONFIRMED
  REPLACED
  DROPPED
  REORGED_OUT
  ALTERNATE_SPEND
}

// Missão 11 Fase 9.1 §1 — the durable, append-only evidence trail Phase
// 9.0's own audit found missing for escrow FUNDING (as opposed to fee
// COLLECTION, which already had FeeCollectionEvidence). Deliberately
// mirrors that table's own shape and discipline exactly — same
// "smallest existing pattern" reasoning the audit itself asked for, not
// a novel design. No DB-native immutability trigger (unlike
// CustodyAttestation, or FeeCollectionEvidence's own narrower
// distributionPolicyVersionId guard): there is no single
// economically-binding column here that needs hard DB-level protection
// the way a frozen policy reference does — append-only discipline is
// enforced at the repository layer (record()/listForEscrow() only, no
// update/delete method), the same precedent FeeCollectionEvidence itself
// already relies on for every column except that one.
enum EscrowFundingEvidenceKind {
  // The original funding observation that satisfied lockFunds()'s own
  // confirmation-depth requirement — recorded once, at FUNDS_LOCKED time,
  // so later rows have something concrete to invalidate/reconfirm against.
  OBSERVED_CONFIRMED
  // A previously-OBSERVED_CONFIRMED txid is no longer confirmed on the
  // best chain. Never overwrites or deletes the original OBSERVED_CONFIRMED
  // row — this is a NEW fact ("this txid was later found reorged out"),
  // not a correction of the old one.
  REORGED_INVALIDATED
  // The SAME txid that was REORGED_INVALIDATED has reappeared and been
  // independently re-verified (same confirmation-depth rigor as the
  // original lockFunds() check) to meet the required depth again.
  RECONFIRMED
  // A DIFFERENT txid now funds the same committed script/address at the
  // expected amount — recorded as its own fact, but deliberately does
  // NOT itself clear uncertainty (see isFundingUncertain()) until a
  // RECONFIRMED row is separately recorded for it via the same
  // confirmation-depth rigor lockFunds() itself requires.
  REPLACEMENT_OBSERVED
  // The sweep found a genuinely ambiguous/conflicting state (e.g.
  // multiple candidate UTXOs) it cannot safely auto-classify. Recorded,
  // logged loudly, never auto-resolved.
  AMBIGUOUS
}

// Bounded Remediation (WDK Fund-Moving Safety, 2026-09-08) — the four
// self-initiated WDK_USDT_EVM transfer()-shaped calls a WdkTransferAttempt
// row can represent. SPLIT_BUYER/SPLIT_SELLER are two independent rows
// for the same escrow (splitFunds()'s two non-atomic legs), never one
// combined row — see WdkTransferAttempt's own header comment.
enum WdkTransferOperationType {
  LOCK
  RELEASE
  REFUND
  SPLIT_BUYER
  SPLIT_SELLER
}

// The execution-boundary states WdkTransferAttempt tracks — deliberately
// narrower than a generic transaction-lifecycle enum (docs/WDK_UNKNOWN_OUTCOME_RETRY_SAFETY.md
// §3's own analytical state model, now made durable for exactly this one
// provider). PREPARED means "identity recorded, transfer() not yet
// called." SUBMITTED means a txHash was returned. SUBMISSION_UNKNOWN
// means transfer() threw with no txHash ever obtained — the caller
// cannot distinguish "never reached the network" from "reached it and
// the response was lost," so this state is conservative-by-design and
// blocks retry pending manual reconciliation (docs/WDK_FUND_MOVING_OPERATIONS_SAFETY.md's
// own disclosed residual explains why a finer distinction isn't made).
// CONFIRMED/REVERTED are only ever reached from SUBMITTED, via a real
// receipt query (wdk-execution-truth.ts).
enum WdkTransferAttemptStatus {
  PREPARED
  SUBMITTED
  SUBMISSION_UNKNOWN
  CONFIRMED
  REVERTED
  FAILED_BEFORE_SUBMISSION
}

// Bounded Remediation (WDK Fund-Moving Safety, 2026-09-08) — durable
// operation truth for WDK_USDT_EVM's self-initiated transfer() calls
// (lockFunds/releaseFunds/refundFunds/splitFunds), closing the
// retry-safety gaps docs/WDK_UNKNOWN_OUTCOME_RETRY_SAFETY.md (#56) and
// docs/WDK_FUND_MOVING_OPERATIONS_SAFETY.md (#58) demonstrated. Durably
// records, BEFORE the external side effect, that a specific logical
// operation (this escrow + this operation type, with SPLIT_BUYER/
// SPLIT_SELLER as separate rows) is about to attempt a real transfer —
// so a crash, timeout, or lost response can be reconciled against real
// persisted state instead of Escrow.status alone.
//
// Deliberately WDK-specific, not a generic cross-rail/cross-provider
// primitive — MULTISIG/LIGHTNING_HODL/SAFE_GUARD_EVM's own release/
// refund/split paths are client-signature-collection or read-only
// verification, not self-initiated custodial transfers, so they have no
// equivalent need (docs/WDK_FUND_MOVING_OPERATIONS_SAFETY.md §10).
// Escrow semantic state (Escrow.status) is deliberately NOT replaced or
// duplicated here — this table is the execution-boundary truth layer
// underneath it, a separate concern (see this file's own header comment
// on WdkTransferAttemptStatus).
//
// One row per attempt generation, append-only (never overwritten) — a
// fresh row for the same (escrowId, operationType) is only ever created
// once a PRIOR row reached a state proven safe to retry
// (FAILED_BEFORE_SUBMISSION, or REVERTED for a split leg specifically —
// wdk-execution-truth.ts's own state machine has the full reasoning),
// preserving full history rather than overwriting it — the same
// append-only evidence-table convention EscrowFundingEvidence/
// EscrowReleaseEvidence already established in this file.
model WdkTransferAttempt {
  id            String                   @id @default(uuid())
  escrowId      String
  escrow        Escrow                   @relation(fields: [escrowId], references: [id])
  operationType WdkTransferOperationType
  status        WdkTransferAttemptStatus @default(PREPARED)
  destination   String
  amount        Decimal                  @db.Decimal(24, 8)
  chainId       Int?
  txHash        String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  // Exactly one row per logical operation may own submission authority.
  // Safely retryable terminal attempts remain as history but relinquish this
  // nullable key before a replacement generation is created.
  activeKey     String?                  @unique

  // The durable-identity query this table exists to answer: "is there
  // already an active (non-safely-retryable) attempt for this exact
  // logical operation?" — wdk-execution-truth.ts's ensureAttempt() always
  // reads the most recent row for (escrowId, operationType) ordered by
  // createdAt.
  @@index([escrowId, operationType, createdAt])
  @@map("wdk_transfer_attempts")
}

// Issue #240 - durable pre/post-submission evidence for the LIGHTNING_HODL/SAFE_GUARD_EVM finalize
// boundary (RestArkProvider.submitTx()+finalizeTx() / the ERC-4337 bundler's eth_sendUserOperation).
// Unlike MULTISIG (Bitcoin broadcast is idempotent by construction - the same signed transaction
// always produces the same txid, so a second broadcast of it is harmless or a no-op) and unlike
// WDK_USDT_EVM (WdkTransferAttempt, a self-initiated direct-call transfer with its own receipt-query
// primitive), neither Ark's submission protocol nor an ERC-4337 bundler's resubmission behavior is
// proven idempotent anywhere in this codebase, and neither provider currently exposes a verified,
// live-tested external query this codebase can safely call during recovery (see each provider's own
// finalizeRelease()/finalizeRefund() header comment). This table therefore exists ONLY to answer one
// question safely: "did Sails already attempt this exact finalize once?" - written SUBMISSION_UNKNOWN
// immediately before the external call (same corrected lesson wdk-execution-truth.ts's own header
// documents: a crash at ANY point from this write onward, including mid-call after a real submission
// may have already gone out, must never look like "never attempted"), then advanced to SUBMITTED or
// CONFIRMED only once the call itself returns - never earlier, never guessed.
//
// SUBMITTED vs CONFIRMED is a REAL distinction only for SAFE_GUARD_EVM: eth_sendUserOperation returns
// the bundler-ACCEPTED userOpHash, not on-chain finality (safe-guard-evm.provider.ts's own broadcast()
// comment) - recorded as SUBMITTED. LIGHTNING_HODL's finalizeTx() has no further async confirmation
// step in this codebase, so a successful return is recorded as CONFIRMED directly - the same standard
// this codebase already applies everywhere else (a SettlementProvider/SignatureCollectionProvider
// finalize call returning without throwing is already treated as done the instant it returns; see
// escrow-pending-tx.ts's own submitTransactionSignature() two-error-boundary comment).
//
// Exactly one row per (escrowId, pendingTxId) - EscrowPendingTransaction.escrowId is itself @unique
// (at most one live signature-collection round per escrow), so this identity never needs WdkTransferAttempt's
// own activeKey/generation-replacement machinery: a genuinely new pending row (a new initiateRelease()/
// initiateRefund() call, only reachable once the prior one was deleted) gets a fresh pendingTxId and
// therefore a fresh identity automatically.
enum SignatureCollectionFinalizationStatus {
  SUBMISSION_UNKNOWN
  SUBMITTED
  CONFIRMED
}

model SignatureCollectionFinalizationAttempt {
  id          String                                 @id @default(uuid())
  escrowId    String                                 @unique
  escrow      Escrow                                 @relation(fields: [escrowId], references: [id])
  pendingTxId String
  kind        String // 'release' | 'refund' - mirrors EscrowPendingTransaction.kind (never 'split': neither provider supports it)
  status      SignatureCollectionFinalizationStatus @default(SUBMISSION_UNKNOWN)
  txHash      String?
  createdAt   DateTime                               @default(now())
  updatedAt   DateTime                                @updatedAt

  @@map("signature_collection_finalization_attempts")
}

// One immutable-once-published policy per (railScope, label). Economic
// columns below (protocolFeeRate through triggerSemantics) are protected by
// TWO independent layers once status leaves DRAFT: (1) the narrow
// fee-policy-repository.ts surface, which exposes no method capable of
// touching them post-DRAFT; (2) a real PostgreSQL BEFORE UPDATE trigger
// (raw SQL — see <timestamp>_add_fee_policy_versioning_foundation/
// migration.sql) that REJECTS any UPDATE touching these columns once
// OLD.status != 'DRAFT', including a raw SQL UPDATE issued outside this
// application entirely. RETIRED stays exactly as immutable as PUBLISHED —
// the trigger's condition is `OLD.status != 'DRAFT'`, not
// `OLD.status = 'PUBLISHED'`, so retiring never reopens the economic fields.
//
// IMPORTANT, disclosed per Fase 2.2's own explicit instruction: `schema.prisma`
// and this project's `db:completeness-check` (`prisma migrate diff
// --from-config-datasource --to-schema prisma/schema.prisma`) do NOT model
// database triggers at all — Prisma's diff engine only compares tables,
// columns, indexes/constraints, and enums. This means db:completeness-check
// will report clean identically whether or not this trigger exists in the
// live database. This is a real, permanent blind spot of that tool for this
// one piece of protection, not a bug in this migration — the trigger's own
// existence must be verified directly against a real Postgres instance (see
// Missão 11 Fase 2.2's own report for that proof), never inferred from
// db:completeness-check passing.
model FeePolicyVersion {
  id        String          @id @default(uuid())
  label     String // human-readable, e.g. "v1-fixture" — unique only in combination with railScope, not globally
  // Free-form string, not FK'd to the EscrowType enum: a policy's rail scope
  // may legitimately outlive/predate the exact enum values Escrow.type
  // offers today (Fase 1.2 §11 — same governance framework, different
  // economics per rail).
  railScope String
  status    FeePolicyStatus @default(DRAFT)

  // Structural validation only (Fase 2.1 §4 / Fase 2.2 §4): rate >= 0 —
  // enforced in fee-policy.service.ts, using Decimal arithmetic (never
  // float, correcting the imprecision already flagged in
  // config.settlement.protocolFeeRate's own live parseFloat typing). The
  // ACTUAL rate is a governance decision explicitly NOT made in this
  // phase — every value used by this pass's own tests is a clearly-labeled
  // fixture.
  protocolFeeRate       Decimal          @db.Decimal(24, 8)
  payerModel            FeePayerModel
  economicBasis         FeeEconomicBasis
  // Missão 11 Fase 7.2 (CTO decision, §I) — remnants of the retired
  // Mechanism 2 distribution architecture (Fase 6.5.2,
  // fee_distribution_batches/fee_distribution_batch_items, permanently
  // write-frozen). DistributionPolicyVersion alone determines revenue
  // allocation going forward — these four columns are no longer
  // normative/required inputs for a NEW FeePolicyVersion's economics,
  // hence nullable (migration 20260824000000, additive — existing
  // historical rows keep their existing values unchanged and remain
  // fully readable; no historical row is rewritten or reinterpreted).
  // FeePolicyVersion = charging economics (rate/payer/basis);
  // DistributionPolicyVersion = allocation economics (who/how much).
  nodeOperatorPct       Decimal?         @db.Decimal(24, 8)
  treasuryPct           Decimal?         @db.Decimal(24, 8)
  walletRebatePct       Decimal?         @db.Decimal(24, 8)
  arbitratorReservePct  Decimal?         @db.Decimal(24, 8)
  // Missão 11 Fase 5 §3 — the confirmation-depth rule a rail's collection-
  // recognition job uses to decide when a broadcast fee output becomes
  // COLLECTED, not a global constant. Nullable, no default: a DRAFT policy
  // may omit it, but publish() (fee-policy.service.ts) refuses to publish
  // a policy without a real, positive value set — same "structural
  // validation only, never a chosen production number" discipline the
  // bucket-percentage-sum-to-100 check already uses. Deliberately NOT
  // duplicated onto Escrow as a separate snapshot column: Escrow.
  // feePolicyVersionId is itself frozen forever (DB trigger,
  // onDelete: Restrict), and this column is protected by the SAME
  // publish-time immutability trigger as every other economic column below
  // — reading it via escrow.feePolicyVersion.requiredConfirmations at
  // confirmation-check time is therefore already guaranteed to return the
  // exact value that was live when this escrow was created, with no
  // separate freeze mechanism needed.
  requiredConfirmations Int?
  // Rail-specific, deliberately still-evolving structured data (Fase 1.2
  // §4/§5) — genuinely variable shape per rail, same "flexible JSON for
  // still-evolving structured data" precedent this schema already uses for
  // Dispute.evidence/Intent.payload. Field names inside are NOT
  // schema-approved.
  smallTradeRule        Json             @default("{}")
  triggerSemantics      Json             @default("{}")

  createdBy   String // caller-supplied identifier; no real admin/operator role model exists in this codebase yet (Fase 2 §15, open question)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  retiredAt   DateTime?

  obligations FeeObligation[]
  escrows     Escrow[]

  @@index([railScope, status])
  @@map("fee_policy_versions")
}

// One row per escrow that has BOTH a non-null Escrow.feePolicyVersionId AND
// has reached a terminal settlement outcome (Fase 2.1 §3 — revising Fase 2's
// original "absence = not applicable" design, which could not distinguish a
// deliberate exemption from a bug). For any such escrow, absence of this row
// is provably an error, never an ambiguous case. Legacy escrows
// (feePolicyVersionId IS NULL) remain the one clean, permanent exception —
// gated by that null check BEFORE ever asking "should an obligation exist,"
// never processed through this model at all.
model FeeObligation {
  id                 String           @id @default(uuid())
  escrowId           String           @unique
  escrow             Escrow           @relation(fields: [escrowId], references: [id])
  feePolicyVersionId String
  feePolicyVersion   FeePolicyVersion @relation(fields: [feePolicyVersionId], references: [id])

  economicDetermination FeeEconomicDetermination
  // Null when economicDetermination = NOT_APPLICABLE — deliberately no
  // collection lifecycle for a determination that was never owed (Fase 2.2
  // §6's explicit instruction).
  collectionStatus      FeeCollectionStatus?

  basisAmount Decimal?   @db.Decimal(24, 8) // the seller-delivered value the fee was computed against; null for NOT_APPLICABLE
  computedFee Decimal?   @db.Decimal(24, 8) // null for NOT_APPLICABLE
  asset       AssetType?

  recipientAddress String?

  // Set exactly once, when included in a FeeDistributionBatchItem — the
  // @@unique on FeeDistributionBatchItem.feeObligationId (below) is the real
  // DB-level guarantee against double distribution; this column is a cheap,
  // redundant, single-column "is this undistributed" check
  // (collectionStatus = COLLECTED AND distributedInBatchId IS NULL).
  // Same onDelete: Restrict reasoning as Escrow.feePolicyVersion above —
  // Prisma's default for this optional relation would otherwise be SET
  // NULL, letting a FeeDistributionBatch be deleted out from under an
  // obligation it already claimed, silently making a distributed fee
  // reappear as "undistributed."
  distributedInBatchId String?
  distributedInBatch   FeeDistributionBatch? @relation(fields: [distributedInBatchId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence                 FeeCollectionEvidence[]
  distributionItems        FeeDistributionBatchItem[]
  // Missão 11 Fase 6.3A — the new entitlement-ledger foundation's own
  // back-relation, additive alongside (never replacing) distributionItems
  // above (the legacy, pre-Fase-6.3A mechanism — see BACKLOG.md's own
  // classification of it).
  entitlementLedgerEntries EntitlementLedgerEntry[]

  @@index([feePolicyVersionId])
  @@index([collectionStatus])
  @@map("fee_obligations")
}

// Append-only, mirroring EscrowEvent's own discipline (Fase 2.1 §8 /
// Fase 2.2 §7) — no repository method in this codebase ever updates or
// deletes a row here (fee-collection-evidence-repository.ts exposes create()
// and reads only). A correction (RBF replacement, reorg) is always a NEW
// row, never an edit to an old one, so the full forensic history of what was
// believed true at each point in time is permanently preserved.
model FeeCollectionEvidence {
  id                String                    @id @default(uuid())
  feeObligationId   String
  feeObligation     FeeObligation             @relation(fields: [feeObligationId], references: [id])
  kind              FeeCollectionEvidenceKind
  txid              String?
  vout              Int?
  scriptPubKey      String?
  amount            Decimal?                  @db.Decimal(24, 8)
  confirmedAtHeight Int?
  note              String?
  recordedAt        DateTime                  @default(now())

  // Missão 11 Fase 7.2 — CTO-frozen decision: DistributionPolicyVersion
  // becomes economically binding at COLLECTED time, not at whenever an
  // allocation worker happens to run. Meaningful ONLY for kind=CONFIRMED
  // (null for BROADCAST/REPLACED rows) — resolved once, by
  // fee-collection-recognition.service.ts's recognizeConfirmation(), in
  // the SAME insert that creates this row, and never touched again
  // (fee_collection_evidence_distribution_policy_immutability_guard,
  // migration 20260824000000, rejects any UPDATE of this column
  // unconditionally — including null -> non-null, i.e. no backfill).
  // Null is a real, permanent, legitimate outcome when zero
  // DistributionPolicyVersion was PUBLISHED at confirmation time (today's
  // actual state) — EntitlementAllocationService.allocate() must treat a
  // null value here as "no frozen policy," never as license to adopt
  // whatever is live when allocation eventually runs.
  distributionPolicyVersionId String?
  distributionPolicyVersion   DistributionPolicyVersion? @relation(fields: [distributionPolicyVersionId], references: [id], onDelete: Restrict)

  // Missão 11 Fase 6.3A — a CONFIRMED-kind row here is itself the
  // "collection generation" identity an entitlement-allocation generation
  // references (Phase 6.2.1's own CTO-frozen decision — no new concept).
  entitlementLedgerEntries EntitlementLedgerEntry[]

  @@index([feeObligationId, recordedAt])
  @@map("fee_collection_evidence")
}

// Missão 11 Fase 9.1 §1 — the durable funding-side counterpart to
// FeeCollectionEvidence above, closing the Phase 9.0 audit's own INV-07F
// finding. Append-only by the same repository-layer discipline (no
// update/delete method anywhere in escrow-funding-evidence-repository.ts).
// Deliberately a NEW CHILD TABLE, not a field on Escrow itself — no
// existing historical fact on Escrow (status, txLockId, txLockVout) is
// ever touched by anything that writes here; a reorg observation is
// always a new row referencing the same escrowId, never a correction of
// an old one.
model EscrowFundingEvidence {
  id                     String                    @id @default(uuid())
  escrowId               String
  escrow                 Escrow                    @relation(fields: [escrowId], references: [id])
  kind                   EscrowFundingEvidenceKind
  txid                   String?
  vout                   Int?
  amountSats             BigInt?
  observedAtHeight       Int?
  tipHeightAtObservation Int?
  note                   String?
  recordedAt             DateTime                  @default(now())

  @@index([escrowId, recordedAt])
  @@map("escrow_funding_evidence")
}

/// Sails Core Implementation Program M9-F (Release-Leg Finality & Reorg
/// Closure) — the durable, append-only counterpart of
/// EscrowFundingEvidence for the OTHER leg: the main MULTISIG
/// release/refund/split payout (Escrow.txReleaseId), never previously
/// monitored for reorg at all (only its FEE sub-output was, via
/// FeeCollectionEvidence/multisig-fee-reorg-sweep.ts — a REFUND or a
/// fee-waived RELEASE/SPLIT had zero reorg coverage before this
/// mission). Reuses EscrowFundingEvidenceKind verbatim — the same
/// OBSERVED_CONFIRMED / REORGED_INVALIDATED / RECONFIRMED /
/// REPLACEMENT_OBSERVED / AMBIGUOUS state shape applies identically to
/// "was this specific txid confirmed, and is it still" regardless of
/// which leg of the escrow it describes; a second, duplicate enum would
/// only fragment one real concept into two names for the same thing.
///
/// Append-only by design, identical discipline to EscrowFundingEvidence:
/// a later observation (reorg, reconfirmation) is always a NEW row, never
/// an edit to a prior one. A reorg on this leg NEVER retroactively
/// changes the historical CorrespondenceEvaluation recorded when the
/// transaction was first observed (see dispute-correspondence.ts's own
/// header) — MATCH-at-the-time-it-was-evaluated remains a true historical
/// fact; current chain inclusion is a separate, later question this table
/// answers instead.
model EscrowReleaseEvidence {
  id                     String                    @id @default(uuid())
  escrowId               String
  escrow                 Escrow                    @relation(fields: [escrowId], references: [id])
  kind                   EscrowFundingEvidenceKind
  txid                   String?
  observedAtHeight       Int?
  tipHeightAtObservation Int?
  note                   String?
  recordedAt             DateTime                  @default(now())

  @@index([escrowId, recordedAt])
  @@map("escrow_release_evidence")
}

// Batch-level distribution run metadata. Accounting/provenance ONLY — no
// real financial transfer is implemented anywhere in this pass (Fase 2.2 §8).
model FeeDistributionBatch {
  id          String    @id @default(uuid())
  asset       AssetType
  totalAmount Decimal   @db.Decimal(24, 8)
  executedAt  DateTime  @default(now())

  items       FeeDistributionBatchItem[]
  obligations FeeObligation[]

  @@map("fee_distribution_batches")
}

// One row per FeeObligation included in a batch. feePolicyVersionId is
// deliberately denormalized (copied at inclusion time, Fase 1.2 §9 / Fase 2
// §9) so a batch report can group/subtotal per policy version without
// re-joining through every historical obligation, and so a settled batch's
// own provenance record is self-contained. The bucket-share amounts here are
// always computed from THIS obligation's OWN policy version — never the
// policy version live at distribution time — which is what makes a batch
// spanning multiple policy versions provenance-safe.
//
// @@unique([feeObligationId]) is the real DB-level guarantee that a
// FeeObligation can never be distributed twice (Fase 2.2 mandate item 8) —
// independent of, and in addition to, the application-level
// collectionStatus/distributedInBatchId checks.
model FeeDistributionBatchItem {
  id                     String               @id @default(uuid())
  batchId                String
  batch                  FeeDistributionBatch @relation(fields: [batchId], references: [id])
  feeObligationId        String               @unique
  feeObligation          FeeObligation        @relation(fields: [feeObligationId], references: [id])
  feePolicyVersionId     String
  amount                 Decimal              @db.Decimal(24, 8)
  nodeOperatorShare      Decimal              @db.Decimal(24, 8)
  treasuryShare          Decimal              @db.Decimal(24, 8)
  walletRebateShare      Decimal              @db.Decimal(24, 8)
  arbitratorReserveShare Decimal              @db.Decimal(24, 8)
  createdAt              DateTime             @default(now())

  @@index([batchId])
  @@index([feePolicyVersionId])
  @@map("fee_distribution_batch_items")
}

// ─── Missão 11 Fase 6.3A — Distribution & Entitlement Accounting Foundation ─
//
// CTO-authorized ACCOUNTING FOUNDATION ONLY (Phase 6/6.1/6.2/6.2.1's own
// read-only economic design, now implemented). Does NOT activate any real
// payout, does NOT select production Node/Wallet percentages, does NOT
// activate the 0.40% Protocol Fee, and does NOT publish any
// DistributionPolicyVersion — every row these four models can hold in this
// pass's own tests is an explicitly-labeled fixture, mirroring the exact
// "structural foundation only" discipline FeePolicyVersion/FeeObligation
// (Fase 2.2) already established for fee assessment. See:
//   - PROTOCOL_ECONOMY.md — the historical 35/30/25/10 design proposal this
//     foundation deliberately does NOT carry forward as a production default;
//   - Missão 11 Phase 6/6.1/6.2/6.2.1 chat reports — the full economic
//     design/audit trail behind every decision encoded structurally below.
//
// DistributionPolicyVersion is INDEPENDENT from FeePolicyVersion (Phase 6.2
// D9's own explicit decision): FeePolicyVersion answers "how much fee is
// assessed/collected"; DistributionPolicyVersion answers "once collected,
// who is economically entitled to it." Deliberately protocol-level (no
// railScope) — distribution percentages are not rail-specific economics,
// unlike fee-collection mechanics.
enum DistributionPolicyStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// A stable, permanent economic IDENTITY — WHO owns entitlement. Explicitly
// NOT a payout address (Phase 6.2 §8's own proof: recipient identity and
// payout destination are separate concepts; this model holds no address at
// all, by design, not by omission — a future payout mechanism would add its
// own, separately-versioned destination-assignment concept referencing this
// same stable identity, never the other way around).
//
// `class` is a free string (mirrors FeePolicyVersion.railScope's own
// precedent) — 'SAILS_PROTOCOL' is the only class this pass ever creates a
// real row for; 'NODE'/'WALLET'/'ARBITER' are NOT implemented here (Phase
// 6.1 §7/§8: no Sybil-resistant proof-of-contribution mechanism exists yet
// for any of them) but require zero schema change to add later — a future
// phase would simply create new DistributionRecipient rows of a new class.
//
// `identityKey` distinguishes multiple identities within the SAME class
// (e.g., a future world with many distinct NODE operators) — always NULL
// for the single SAILS_PROTOCOL Treasury identity. A hand-written partial
// unique index (this migration's own raw SQL, Prisma has no schema-level
// partial-unique syntax) enforces "at most one NULL-identityKey row per
// class" — i.e., at most one Treasury, ever — while leaving room for many
// non-null-identityKey rows of a future class with zero migration.
model DistributionRecipient {
  id          String   @id @default(uuid())
  class       String // e.g. 'SAILS_PROTOCOL' — the only class populated by this pass
  identityKey String? // NULL for a singleton class (SAILS_PROTOCOL); a stable external identity string for a future multi-instance class
  label       String // human-readable, e.g. "Sails Protocol Treasury"
  createdAt   DateTime @default(now())

  policyRecipients    DistributionPolicyRecipient[]
  ledgerEntries       EntitlementLedgerEntry[]
  custodyAttestations CustodyAttestation[]

  @@index([class])
  @@map("distribution_recipients")
}

// Missão 11 Fase 7.3.2 §3 (CTO-approved design: Option 2, append-only
// custody attestation) — records an ATTESTED ASSOCIATION between a
// DistributionRecipient (an economic identity — "who is owed") and a
// rail-specific custody descriptor (where that recipient's collected
// funds are operationally understood to be held). Deliberately NOT
// cryptographic proof of control: see attestationAuthority below.
// Deliberately separate from Escrow.snapshotFeeCollectionAddress (the
// real, frozen destination a SPECIFIC settlement's fee was actually sent
// to) — this table answers "who does the operator say owns what's at
// that kind of destination," never "prove it," and never redirects,
// authorizes, or moves any fund. No private key is ever stored here.
//
// Append-only by design, enforced by a real Postgres trigger (this
// model's own migration) exactly like FeePolicyVersion/the arbiter
// pubkey commitment: once written, a row may only ever have its
// supersededAt column move from NULL to a real timestamp, exactly once —
// every other column, and every other kind of update, is rejected. A
// superseded row is NEVER deleted or rewritten, so "what did we attest
// for recipient X at time T" is always a real, deterministic historical
// query, immune to a later rotation silently rewriting the past.
model CustodyAttestation {
  id          String                @id @default(uuid())
  recipientId String
  recipient   DistributionRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  // Rail-agnostic on purpose — a free string (same precedent as
  // FeePolicyVersion.railScope/Escrow.asset), so a future rail (RSK,
  // Stacks, etc.) never needs a schema change here.
  asset String

  // Free-form, rail-specific shape (e.g. {address, custodian, note} for
  // BTC; a different shape entirely for an EVM/other rail) — never
  // interpreted structurally by this table or its own code, only by
  // whoever reads it for a specific rail. This is exactly what keeps
  // every recipient from being forced into Bitcoin-address semantics.
  descriptor Json

  // Explicit, honest label for what KIND of claim this row represents,
  // so the schema never has to be replaced to add a stronger guarantee
  // later. Today only BOOTSTRAP_OPERATOR_ATTESTED is ever written (a
  // human operator's own asserted claim via scripts/draft-economic-policy.ts,
  // the same trust boundary as every other bootstrap-operator action in
  // this codebase — no signature, no on-chain proof). CRYPTOGRAPHIC_PROOF
  // is reserved and structurally representable, but nothing in this
  // codebase produces one yet.
  attestationAuthority CustodyAttestationAuthority @default(BOOTSTRAP_OPERATOR_ATTESTED)

  attestedBy String // operator attribution — same "no fabricated identity" convention as every other bootstrap-operator action
  attestedAt DateTime @default(now())

  // NULL = this is the CURRENTLY ACTIVE attestation for (recipientId,
  // asset) — enforced by a real partial unique index (this model's own
  // migration), never merely a convention. Set exactly once, by the
  // repository's own create() (inside the same transaction as the new
  // row's insert), the moment a newer attestation for the same
  // (recipientId, asset) is created.
  supersededAt DateTime?

  createdAt DateTime @default(now())

  @@index([recipientId, asset, attestedAt])
  @@map("custody_attestations")
}

enum CustodyAttestationAuthority {
  BOOTSTRAP_OPERATOR_ATTESTED
  CRYPTOGRAPHIC_PROOF
}

// Immutable-once-published policy, same two-layer immutability discipline
// as FeePolicyVersion (Fase 2.1 §1 decision D): (1) this repository's own
// narrow surface, (2) a real PostgreSQL trigger on the CHILD
// DistributionPolicyRecipient rows (this economic content lives one level
// down, not inline on this row — see that model's own comment) rejecting
// any INSERT/UPDATE/DELETE of a recipient once the parent's status != DRAFT.
model DistributionPolicyVersion {
  id          String                   @id @default(uuid())
  label       String // human-readable, e.g. "test-fixture-90-10" or "v1-bootstrap-treasury-only"
  status      DistributionPolicyStatus @default(DRAFT)
  createdBy   String
  createdAt   DateTime                 @default(now())
  publishedAt DateTime?
  retiredAt   DateTime?

  recipients                     DistributionPolicyRecipient[]
  ledgerEntries                  EntitlementLedgerEntry[]
  // Missão 11 Fase 7.2 — the FeeCollectionEvidence(CONFIRMED) rows that
  // froze this policy version as their governing economic authority at
  // COLLECTED time. See that model's own comment for the full reasoning.
  frozenForCollectionGenerations FeeCollectionEvidence[]

  @@index([status])
  @@map("distribution_policy_versions")
}

// One (recipient, weight) row per policy version — a VARIABLE-LENGTH set
// (1 row today, N later) is exactly what lets a future policy add a
// recipient class without a schema migration (Phase 6.2 §J/§20's own
// extensibility proof) — unlike the legacy FeeDistribution/
// FeeDistributionBatchItem's four hardcoded named share columns.
//
// weightPct mirrors FeePolicyVersion.*Pct's own convention exactly
// (0-100, Decimal(24,8)) — the SAME precision requirement (a percentage-
// like value), for the same reason, deliberately reusing a genuinely
// identical use case rather than inventing a new convention. Validated at
// publish() time (fee-policy.service.ts's own discipline, mirrored):
// every row for one policyVersionId must sum to EXACTLY 100 — no
// tolerance, no silent normalization, no remainder added to another
// recipient. A DRAFT policy's rows may be freely added/removed/edited;
// once the parent policy is not DRAFT, this migration's own trigger
// rejects any further mutation of this table for that policyVersionId.
model DistributionPolicyRecipient {
  id              String                    @id @default(uuid())
  policyVersionId String
  policyVersion   DistributionPolicyVersion @relation(fields: [policyVersionId], references: [id])
  recipientId     String
  recipient       DistributionRecipient     @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  weightPct       Decimal                   @db.Decimal(24, 8)
  createdAt       DateTime                  @default(now())

  @@unique([policyVersionId, recipientId])
  @@map("distribution_policy_recipients")
}

enum EntitlementLedgerEntryKind {
  ALLOCATION
  REVERSAL
}

// Append-only economic ledger — Phase 6.2 §G/§20's chosen source of truth.
// No mutable balance table exists anywhere in this foundation; a
// recipient's balance for (asset, rail) is ALWAYS
// `SUM(amount) WHERE recipientId=x AND asset=y AND rail=z` over this table,
// deterministically reconstructible from first principles at any time
// (Phase 6.2 E13). This migration's own trigger rejects every UPDATE and
// DELETE on this table unconditionally — a correction is always a NEW,
// compensating `REVERSAL`-kind row (negative amount, referencing the
// `ALLOCATION` row it offsets via `reversalOfId`), never an edit.
//
// `confirmationEvidenceId` — Phase 6.2.1's own CTO-frozen decision #3/#4:
// the pre-existing, already-append-only `FeeCollectionEvidence` row of
// kind CONFIRMED IS the identity of one "collection generation" — no new
// CollectionGeneration concept exists (deliberately: it would duplicate an
// identity that already exists). Every entry in one allocation generation
// references the SAME evidence row; a reorg-then-reconfirm cycle produces
// a NEW CONFIRMED evidence row (Fase 5's own append-only design), and
// therefore a NEW, independent set of ledger entries referencing it —
// this is what lets `FeeObligation.id` remain the one permanent revenue-
// event identity while still preserving full per-episode history (Phase
// 6.2.1 §B, the T1-T6 proof).
//
// `distributionPolicyVersionId` is frozen HERE, on the entry itself, at
// the exact moment of that entry's own creation (Phase 6.2.1 CTO decision
// #5) — never on FeeObligation (which would have to be destructively
// overwritten on a second allocation generation) and never inherited from
// a separate concept.
//
// amount uses Decimal(48, 8) — NOT a blind reuse of the schema's own
// pervasive Decimal(24,8) convention (see this migration's own report for
// the full precision proof): scale 8 is independently justified because
// it exactly matches weightPct's own precision (an entitlement amount
// e_i = C × w_i, where C is always a whole native-unit integer, can never
// need more fractional digits than w_i itself contributes — proven, not
// assumed); precision 48 (40 integer digits) is deliberately wider than
// the existing convention's 16 integer digits specifically to safely hold
// a native-smallest-unit amount for a future high-decimal asset (e.g. an
// 18-decimal EVM token's own wei-equivalent count) without truncation or
// overflow, with large headroom for cumulative-balance growth over time.
model EntitlementLedgerEntry {
  id String @id @default(uuid())

  feeObligationId String
  feeObligation   FeeObligation @relation(fields: [feeObligationId], references: [id], onDelete: Restrict)

  confirmationEvidenceId String
  confirmationEvidence   FeeCollectionEvidence @relation(fields: [confirmationEvidenceId], references: [id], onDelete: Restrict)

  distributionPolicyVersionId String
  distributionPolicyVersion   DistributionPolicyVersion @relation(fields: [distributionPolicyVersionId], references: [id], onDelete: Restrict)

  recipientId String
  recipient   DistributionRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  asset AssetType
  // Free string, mirrors FeePolicyVersion.railScope's own convention —
  // NOT an FK to EscrowType (a rail may legitimately outlive/predate that
  // enum's exact values, same reasoning already established there).
  rail  String

  kind   EntitlementLedgerEntryKind
  // Positive for ALLOCATION, negative for REVERSAL — enforced by this
  // migration's own CHECK constraint (defense-in-depth; the service layer
  // never accepts a caller-supplied sign either).
  amount Decimal                    @db.Decimal(48, 8)

  // Set only for kind=REVERSAL — the exact ALLOCATION entry this offsets.
  // The service layer always DERIVES a reversal's feeObligationId/asset/
  // rail/recipientId/distributionPolicyVersionId/amount-magnitude from
  // this referenced row directly (never accepts them as independent
  // caller input), structurally eliminating any wrong-pairing or
  // wrong-magnitude reversal by construction, not merely by a check.
  reversalOfId String?
  reversalOf   EntitlementLedgerEntry?  @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   EntitlementLedgerEntry[] @relation("Reversal")

  createdAt DateTime @default(now())

  // Missão 11 Fase 6.3A §G9/§G10/§H7/§H8 — the real DB-level double-
  // allocation AND double-reversal guard: for one confirmation generation
  // (confirmationEvidenceId) and one recipient, at most one ALLOCATION row
  // and at most one REVERSAL row may ever exist. A retried/concurrent
  // worker's second insert attempt fails on this constraint (P2002),
  // exactly the same idempotency idiom FeeDistributionBatchItem's own
  // @@unique([feeObligationId]) already established — never blocks a
  // legitimate NEW generation under a DIFFERENT confirmationEvidenceId
  // (the reorg-then-reconfirm case, Phase 6.2.1 §B7's E6).
  @@unique([confirmationEvidenceId, recipientId, kind])
  @@index([feeObligationId])
  @@index([recipientId, asset, rail])
  @@map("entitlement_ledger_entries")
}

// Dispute primitive — PROTOCOL_SPECIFICATION.md §1.9. First real
// implementation (04-Deepseek Review.md's raiseDispute()/resolveDispute()
// task) — the primitive itself isn't new, only its persistence.
// resolution maps directly to escrow release/refund: RELEASE -> buyer
// wins (asset released to them), REFUND -> seller wins (asset returned).
enum DisputeStatus {
  OPENED
  EVIDENCE_SUBMITTED
  ARBITRATED
  RESOLVED
  APPEALED // RFC-021 D6 — a RESOLVED dispute reopened for a new arbiter's ruling
  AUTO_PROPOSED // RFC-021 D8 — QVAC proposed an automated ruling; open for contest until autoResolutionDeadline
}

enum DisputeRuling {
  RELEASE // buyer wins — "dispute_resolved_buyer"
  REFUND // seller wins — "dispute_resolved_seller"
  SPLIT // §1.9's third option — no direct buyer/seller equivalent, kept as-is
}

model Dispute {
  id                           String             @id @default(uuid())
  tradeId                      String
  trade                        Trade              @relation(fields: [tradeId], references: [id])
  escrowId                     String
  escrow                       Escrow             @relation(fields: [escrowId], references: [id])
  openedBy                     String // participantId who raised the dispute
  reason                       String
  evidence                     Json               @default("[]") // array of evidence descriptors
  arbiterId                    String? // populated by ArbitrationProvider.assign()
  status                       DisputeStatus      @default(OPENED)
  ruling                       DisputeRuling?
  resolvedAt                   DateTime?
  // RFC-021 D6 — appeal state. appealRound is 0 until the first appeal;
  // previousRuling/previousArbiterId snapshot the ruling being appealed
  // so resolveDispute() can compare the appeal panel's new ruling against
  // it and slash the original arbiter on an overturn (see
  // dispute.service.ts's resolveDispute() for the comparison).
  appealRound                  Int                @default(0)
  previousRuling               DisputeRuling?
  previousArbiterId            String?
  appealFees                   DisputeAppealFee[]
  // RFC-021 D8 — QVAC-assisted automated first-pass resolution. QVAC never
  // decides unilaterally (same "attestor, not mover" principle D1 already
  // establishes for human arbiters): a high-confidence recommendation
  // opens a contest window (either trade party can call POST
  // .../disputes/:id/contest to force human arbitration, exactly D6's
  // escalation framing); if uncontested, sweepExpiredAutoResolutions()
  // (dispute.service.ts) applies it via the SAME already-assigned human
  // arbiter's authorized slot (escrow.service.ts's isSellerOrAssignedArbiter()
  // check is untouched — this never grants a new kind of caller authority
  // to move funds, it only automates when the assigned arbiter doesn't
  // need to personally act). autoResolved distinguishes "the assigned
  // arbiter personally ruled" from "their slot auto-resolved, uncontested"
  // in the audit trail — the arbiter's own recordRuling()/slash()
  // eligibility (RFC-021 D3/D4) is unaffected either way.
  autoResolutionRecommendation DisputeRuling?
  autoResolutionConfidence     Float?
  autoResolutionReasoning      String?
  autoResolutionDeadline       DateTime?
  autoResolved                 Boolean            @default(false)

  // Missão 13 Fase 2 — INV-12 (Attributed Authority Integrity) closure.
  // Additive/nullable: existing rows (every dispute resolved before this
  // migration) simply have none of these set — never backfilled, never
  // fabricated (Missão 13 Fase 2's own Task 38: "never manufacture
  // historical authorization"). `resolveDispute()` now requires all three
  // to be present and independently verifiable (against the arbiter's own
  // already-registered `User.publicKey`, `arbitration-authority.ts`)
  // before any settlement call is made. `authoritySignature`/
  // `authorityIssuedAt` alone are not re-derivable from other columns —
  // they must be persisted verbatim to reconstruct the exact canonical
  // string that was signed, for crash recovery and independent audit
  // alike. `authorityBuyerBps` is a snapshot of the SIGNED SPLIT
  // allocation specifically — distinct from any later-derived value —
  // because `Dispute` itself has no other column carrying it (SPLIT's
  // `buyerBps` today only ever reaches `EscrowPendingTransaction`,
  // created downstream of this decision, too late to answer "what was
  // actually authorized").
  authoritySignature String?
  authorityIssuedAt  DateTime?
  authorityBuyerBps  Int?

  moduleId        String   @default("opensettlement")
  protocolVersion String   @default("0.1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Security-validation round (2026-07-19, CTO-role follow-up, "disputa
  // dupla" scenario): dispute.service.ts's raiseDispute() reads
  // escrow.status, validates the transition, THEN writes — two concurrent
  // calls (buyer and seller both raising a dispute at once) can both read
  // the pre-write status and both pass, since escrow.service.ts's
  // openDispute() has no optimistic-concurrency check either. Without a
  // DB-level constraint, that race produced two OPENED Dispute rows for
  // the same trade, possibly assigned two different arbiters — a real
  // gap, not a hypothetical one. This constraint is the actual fix: the
  // second concurrent create() now fails at the database with a unique-
  // constraint violation (P2002), which raiseDispute() catches and turns
  // into a clean ValidationError instead of silent double-dispute
  // corruption. @@unique rather than a partial/filtered index — this
  // reference implementation's dispute flow has no "reopen after
  // RESOLVED" path, so one Dispute per Trade for its entire lifetime is
  // the real invariant, not just "one at a time."
  @@unique([tradeId]) // also serves as the tradeId lookup index — no separate @@index needed
  @@index([escrowId])
  @@index([status])
  @@index([arbiterId, status]) // P2: performance for arbiter case list queries
  @@map("disputes")
}

// RFC-021 D6 — real appeal-fee collection (BACKLOG.md P0, closed
// 2026-08-01). Real bookkeeping, same "computed and persisted, not
// actually routed on-chain" precedent FeeDistribution above already
// established for the Protocol Fee: no SettlementProvider in this
// codebase has a real configured treasury/arbitrator-reserve address to
// send anything to (chargeProtocolFee() doesn't move funds either — it
// only records who's owed what share). appealFeeRequired used to be
// computed and returned but never persisted anywhere; this is that
// persistence. One row per appeal round (a Dispute can be appealed more
// than once, appealRound incrementing each time) — @@unique enforces
// exactly one charge per round, not one per Dispute for its whole
// lifetime.
model DisputeAppealFee {
  id              String    @id @default(uuid())
  disputeId       String
  dispute         Dispute   @relation(fields: [disputeId], references: [id])
  appealRound     Int
  requestedBy     String // the appellant (participantId) — dispute.service.ts's appeal() caller
  amount          Decimal   @db.Decimal(24, 8)
  asset           AssetType
  // Set once the appeal resolves: FORFEITED (the appeal panel upheld the
  // original ruling — the appellant's appeal was denied, same "cost of a
  // frivolous appeal" this fee exists to be) or REFUNDED (the appeal
  // overturned the original ruling — the appellant was right to appeal).
  // Null while the appeal is still pending.
  outcome         String?
  settledAt       DateTime?
  moduleId        String    @default("opensettlement")
  protocolVersion String    @default("0.1")
  createdAt       DateTime  @default(now())

  @@unique([disputeId, appealRound])
  @@map("dispute_appeal_fees")
}

// RFC-021 D1-D3 (`rfcs/RFC-021-market-based-arbitration-and-payment-trust.md`)
// — permissionless arbiter registration, replacing TrustedArbitratorProvider's
// static TRUSTED_ARBITRATORS allowlist. Deliberately a separate reputation
// dimension from User.reputationScore (trader reputation): an arbiter's
// track record and a trader's trade history measure different things and
// must be able to diverge — see RFC-021 D3.
model ArbiterProfile {
  id                     String     @id @default(uuid())
  participantId          String     @unique
  participant            User       @relation(fields: [participantId], references: [id])
  monetaryCollateral     Decimal    @default(0) @db.Decimal(24, 8)
  collateralAsset        AssetType? // null when monetaryCollateral is 0
  arbiterReputation      Float      @default(0)
  rulingsTotal           Int        @default(0)
  rulingsOverturned      Int        @default(0) // RFC-021 D6 appeal outcomes
  cumulativeFeesObserved Decimal    @default(0) @db.Decimal(24, 8) // RFC-021 D4, Phase 3
  registeredAt           DateTime   @default(now())
  slashedAt              DateTime?
  moduleId               String     @default("opensettlement")
  protocolVersion        String     @default("0.1")
  updatedAt              DateTime   @updatedAt

  @@map("arbiter_profiles")
}

// RFC-021 D5 — payment-account trust ramp, modeled on Bisq's real
// "Payment account age witness"/account signing (verified against
// Bisq's own docs before proposing this). A SEPARATE risk dimension
// from trader reputation and arbiter reputation above: this measures
// whether a specific payment rail (a PIX key, a bank account) has
// survived a completed trade without a chargeback, not whether the
// identity behind it behaves well in general — the two are genuinely
// different attacks (a stolen/mule account can belong to an otherwise
// reputable trader's compromised identity).
model PaymentAccount {
  id              String        @id @default(uuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id])
  // Privacy-preserving hash of the real account identifier (PIX key,
  // bank account number) — never the raw value. Bisq's own
  // AccountAgeWitness uses the same shape: a hash both sides can check
  // without either seeing the other's real account data.
  accountHash     String        @unique
  paymentMethod   PaymentMethod
  signed          Boolean       @default(false)
  signedBy        String? // the counterparty/arbiter who attested the first clean trade (RFC-021 D1's narrow factual-claim framing)
  signedAt        DateTime?
  firstUsedAt     DateTime      @default(now())
  completedTrades Int           @default(0)
  chargebacks     Int           @default(0)
  moduleId        String        @default("opensettlement")
  protocolVersion String        @default("0.1")
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
  @@map("payment_accounts")
}

// BACKLOG.md's own "Participant payout address" row, closed 2026-08-04 —
// a real, recurring gap surfaced by the dispute work: resolveDispute()'s
// RELEASE/SPLIT rulings and escrow.service.ts's releaseFunds()/
// splitFunds() all needed a real crypto payout address for a
// participant, and no schema field modeled one for any asset. Separate
// from PaymentAccount above (that's the FIAT rail a trader receives PIX/
// bank transfers on, this is the crypto address a trader receives
// released escrow funds at) and separate per-asset (a participant's BTC
// address and their USDT/EVM address are unrelated values) — one row per
// (participant, asset), not one address covering everything.
model PayoutAddress {
  id              String    @id @default(uuid())
  participantId   String
  participant     User      @relation(fields: [participantId], references: [id])
  asset           AssetType
  address         String
  moduleId        String    @default("opensettlement")
  protocolVersion String    @default("0.1")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([participantId, asset])
  @@map("payout_addresses")
}

// RFC-021 D7 — peer vouching, the real bootstrap mechanism for two
// brand-new participants who would otherwise both start at zero (Yuri's
// "handshake at Anarcapulco" analogy, project owner's own 2026-08-02
// correction: this is NOT a KYC/identity-linking flow — it is a
// protocol-native attestation with the voucher's own reputation on the
// line, the same "reputation as slashable collateral" principle D3
// already applies to arbiters, extended here). One vouch per
// (voucher, vouchee) pair, ever — @@unique enforces this at the database
// level, not just in application code. burnedAt is set (once, real skin
// in the game) if the vouchee's first lost dispute happens while this
// vouch is still active — see reputation.service.ts's
// penalizeForBurnedVouch() and vouch.service.ts's burnVouchesFor().
model Vouch {
  id              String    @id @default(uuid())
  voucherId       String
  voucher         User      @relation("VouchesGiven", fields: [voucherId], references: [id])
  voucheeId       String
  vouchee         User      @relation("VouchesReceived", fields: [voucheeId], references: [id])
  createdAt       DateTime  @default(now())
  burnedAt        DateTime?
  moduleId        String    @default("openreputation")
  protocolVersion String    @default("0.1")

  @@unique([voucherId, voucheeId])
  @@index([voucheeId])
  @@map("vouches")
}

model EscrowEvent {
  id          String       @id @default(uuid())
  escrowId    String
  escrow      Escrow       @relation(fields: [escrowId], references: [id])
  fromStatus  EscrowStatus
  toStatus    EscrowStatus
  triggeredBy String
  note        String?
  createdAt   DateTime     @default(now())
  // RFC-008 D2 amendment (Missão 05.5, 2026-08-15) — the same
  // tamper-evident hash chain IntentEvent already has, same composition:
  // sha256(fromStatus+toStatus+triggeredBy+prevHash), computed once at
  // write time by escrow-lifecycle.ts's emitEscrowTransition(), never
  // (re)computed at read time. Nullable so pre-migration rows stay valid
  // as-is — see this model's own migration file for the historical-rows
  // strategy (a NULL entryHash marks "written before the chain existed,"
  // not a break in it).
  entryHash   String?
  prevHash    String? // prior EscrowEvent.entryHash for this escrowId; 'genesis' for the first post-migration entry

  // Same hot-path reasoning RELATORIO_PERFORMANCE.md already established
  // for intent_events: the chain's write path does
  // findFirst(where: { escrowId }, orderBy: { createdAt: 'desc' }) on
  // every single Escrow transition to read the prior entryHash.
  @@index([escrowId, createdAt])
  @@map("escrow_events")
}

// Sails Core Implementation Program M3.5 — durable semantic Transition
// Record precondition for Core authority
// (docs/CORE_IMPLEMENTATION_ARCHITECTURE.md §12: "No semantic decision
// becomes Core-authoritative before a durable Transition Record exists
// for that decision class."). See docs/CORE_TRANSITION_RECORD.md for
// the full design rationale — why this is a separate table from
// EscrowEvent (a Record explains WHY a semantic decision was valid;
// EscrowEvent reports WHAT the Runtime observed happened — deliberately
// not merged, docs/CORE_IMPLEMENTATION_ARCHITECTURE.md §9), and why the
// table is interaction-kind-neutral rather than Escrow-specific.
//
// Corrigido/Implementado 2026-08-30 (Mission M8-R) — the paragraph above
// is now stale: M4 (Retry) wired this table into escrow.service.ts's
// sweepExpiredEscrows() as the first live authority slice, and M8-R adds
// a second, discretionary/outcome-bearing slice (Mission13 MULTISIG
// dispute ruling) — see dispute-outcome.ts's own header. Kept here
// rather than deleted so the original M3.5 design intent (why the table
// exists, why it is interaction-kind-neutral) remains legible.
model SemanticTransitionRecord {
  id String @id @default(uuid())

  // Core InteractionId (opaque, protocol-general) — deliberately no
  // Prisma relation to Escrow specifically: every value happens to be
  // an escrow id today, but this table must not need a schema change
  // when a second Interaction kind eventually migrates.
  interactionId String

  // CandidateTransition — for this first slice a plain from/to state
  // pair fully describes the payload; a generic JSON payload column is
  // deferred until a transition genuinely needs one.
  transitionType String
  fromState      String
  toState        String

  // SemanticHistoryPosition | LegacyUnverified (packages/sails-core/src/semantic-history-position.ts) —
  // both arms of the frozen union are representable; only
  // LEGACY_UNVERIFIED is exercised by this slice (§30 Migration
  // Genesis), since Escrow has never had a prior Core Transition Record.
  priorPositionKind      SemanticPriorPositionKind
  priorPositionReference String? // opaque Runtime reference, populated only when priorPositionKind = RESOLVED

  // RulesetRef (packages/sails-core/src/ruleset.ts) — the EXPECTED
  // evaluator/profile identity the Ruleset itself declares.
  rulesetName                     String
  rulesetIdentity                 String
  rulesetVersion                  String
  rulesetCommitment               String
  rulesetExpectedEvaluatorName    String
  rulesetExpectedEvaluatorVersion String
  rulesetExpectedProfileName      String
  rulesetExpectedProfileVersion   String

  // Actual evaluator/profile identity USED for this decision — never
  // merely the Ruleset's expected identity (§11 Actual != Expected).
  evaluatorIdentityName    String
  evaluatorIdentityVersion String
  profileIdentityName      String
  profileIdentityVersion   String

  // Committed semantic inputs — Core's own EvaluationTime
  // representation (packages/sails-core/src/time.ts): integer
  // milliseconds since the Unix epoch, never a Date, never seconds,
  // per conformance/profiles/sails-semantic-profile-1.0.json's own
  // integerRepresentation rule. BigInt (Postgres BIGINT) stores this
  // exactly, with no float/JSON-number precision risk.
  deadlineMs       BigInt
  evaluationTimeMs BigInt

  // ConditionResult (packages/sails-core/src/condition-result.ts) — the
  // schema supports all four frozen values; this slice's own
  // persistence code only ever writes SATISFIED (a Record is only ever
  // created for a decision that actually authorized the transition).
  conditionResult SemanticConditionResult

  // attribution (K2) and outcome (K3) were both absent by design for
  // M4's deterministic, non-fund-moving expiry slice — no columns were
  // added for either. Mission M8-R (Mission13 MULTISIG dispute ruling)
  // is exactly the "future discretionary/outcome-bearing slice" this
  // comment anticipated: both groups below are populated for that
  // decision class, and remain NULL for M4's own rows.
  //
  // attribution — DiscretionaryAttributionMaterial (transition.ts,
  // frozen M1). Never a bare `verified: true` — the raw proof and
  // resolved identity a future independent verifier actually needs
  // (CORE_IMPLEMENTATION_ARCHITECTURE.md §13's own explicit rule).
  // All three columns are populated together or not at all (enforced in
  // code, dispute-outcome.ts — not a DB CHECK constraint, matching this
  // model's own existing precedent of code-enforced, not DB-enforced,
  // cross-column invariants).
  attributionActor            String? // DiscretionaryAttributionMaterial.actor (the arbiter's authorityId)
  attributionRawProof         String? // the raw Ed25519 signature hex — never a cached boolean
  attributionResolvedIdentity String? // the arbiter's resolved User.publicKey hex, at decision time

  // outcome — Outcome<ArbitrationOutcomeContent, readonly BeneficiaryDestination[]>
  // (outcome.ts, frozen M1; economic-outcome.ts, M7, for the concrete
  // domain content shape). JSON because Core's own Outcome.content is
  // opaque to generic persistence — this table must not need a schema
  // change for a future Outcome content shape from a different Ruleset.
  outcomeContent            Json? // ArbitrationOutcomeContent (ruling, totalUnits, asset, allocations, remainderBeneficiary)
  outcomeDestinationBinding Json? // readonly BeneficiaryDestination[] — the M8.5 destination snapshot, bound at this exact commit

  createdAt DateTime @default(now())

  // Replay resistance: under the CURRENT frozen VALID_TRANSITIONS graph
  // (escrow-lifecycle.ts), EXPIRED is reachable at most once per escrow,
  // ever — so (interactionId, transitionType) was a correct, real
  // idempotency key for M4 alone.
  //
  // Mission M8-R — a single escrow's dispute-ruling transition IS
  // legitimately repeatable across appeal rounds (appeal() resets
  // Dispute.status, allowing a NEW resolveDispute() call for the SAME
  // escrowId with the SAME transitionType) — exactly the technical-debt
  // scenario this model's own prior comment flagged. `appealRound` closes
  // it: a real, additive column (not folded into `transitionType`, which
  // stays the semantic TYPE of decision, unchanged in meaning) with a
  // NON-NULL sentinel default of -1 ("not applicable to this transition
  // type"), never a nullable column — Postgres's own default NULLS
  // DISTINCT behavior (already relied on elsewhere in this schema, see
  // Escrow.txLockVout's own comment) would otherwise treat every one of
  // M4's own NULL-appealRound rows as mutually non-conflicting, silently
  // defeating the exact replay-resistance guarantee M3.5-V proved with
  // real Postgres. Every M4 row backfills to -1 by this migration's own
  // default; M8-R rows carry their real appealRound (0, 1, 2, ...),
  // matching Mission13's own signed AuthorityDecisionPayload.appealRound
  // replay-resistance dimension exactly.
  appealRound Int @default(-1)

  @@unique([interactionId, transitionType, appealRound])
  @@index([interactionId])
  @@map("semantic_transition_records")
}

/// Sails Core Implementation Program M9-R (Recovery Closure), Part 5/6/7
/// — closes a real concurrency + drift gap the M9 analytical gate found
/// in `recordLiveCorrespondenceIfApplicable()`'s own idempotency guard:
/// a presence-only check against the `durable_events` log (`getEvents()`
/// then `emit()` if absent) is NOT atomic — two concurrent reconciliation
/// workers can both observe "no existing event" before either writes,
/// producing two durable observations of the same fact. `durable_events`
/// itself stays exactly as it was (append-only, no new columns, never
/// mutated) — this table is a separate, minimal, real DURABLE CLAIM
/// primitive, the same "unique constraint IS the atomicity" pattern
/// `SemanticTransitionRecord` and `EscrowPendingTransaction` already use,
/// applied here instead of inventing new locking machinery.
///
/// The unique identity is `(escrowId, appealRound, evaluatorIdentity,
/// policyVersion)` — DELIBERATELY not just `(escrowId, appealRound)`:
/// `policyVersion` (a deterministic hash of the execution-cost policy
/// bounds actually in force — `execution-cost-policy.ts`'s own
/// `computeExecutionCostPolicyIdentity()`) makes an OLD execution
/// re-evaluated under a genuinely CHANGED policy a NEW, additional,
/// independently-recorded row — never an overwrite of the old one
/// (history stays append-only) — while the SAME policy version can only
/// ever claim this identity once, closing the concurrency race. `results`
/// (the same per-beneficiary CorrespondenceResult map already emitted on
/// `durable_events`) is stored here too specifically so a later, SAME-
/// identity re-evaluation can be compared against it — a disagreement
/// under the identical evaluator+policy identity is a genuine semantic
/// inconsistency (a non-deterministic evaluator, or tampered persisted
/// inputs), never silently accepted; see
/// `recordLiveCorrespondenceIfApplicable()`'s own fail-closed check.
model CorrespondenceEvaluation {
  id String @id @default(uuid())

  escrowId    String
  appealRound Int

  // The evaluator identity ACTUALLY used (same "actual, not merely
  // expected" discipline SemanticTransitionRecord's own
  // evaluatorIdentityName/Version columns already establish) —
  // SAILS_DESTINATION_CORRESPONDENCE_EVALUATOR_IDENTITY today.
  evaluatorIdentityName    String
  evaluatorIdentityVersion String

  // computeExecutionCostPolicyIdentity()'s own hash of the execution-cost
  // bounds in force at evaluation time — the one SEMANTIC INPUT the M9
  // report found could change a historical CorrespondenceResult (never
  // an arbitrary environment-variable snapshot; see that function's own
  // header for why network/explorer config is deliberately excluded).
  policyVersion String

  // Record<beneficiaryId, 'MATCH'|'DIVERGENT'|'PENDING'|'UNKNOWN'> — the
  // same shape already emitted on the durable_events log, kept here too
  // so a later same-identity recomputation has something real to compare
  // against, not just a presence flag.
  results Json

  createdAt DateTime @default(now())

  @@unique([escrowId, appealRound, evaluatorIdentityName, evaluatorIdentityVersion, policyVersion], name: "correspondence_evaluation_identity")
  @@index([escrowId])
  @@map("correspondence_evaluations")
}

enum SemanticPriorPositionKind {
  LEGACY_UNVERIFIED
  RESOLVED
}

enum SemanticConditionResult {
  SATISFIED
  NOT_YET_SATISFIED
  UNSATISFIABLE
  UNKNOWN
}

// Intent persistence — PROTOCOL_SPECIFICATION.md §2 (Intent Engine), §2.6.
// Was "not yet implemented" per that section; this is the first real
// implementation, built for the MVP happy path (03-implementation_plan.md,
// approved by CISO + CTO).
model Intent {
  id             String    @id @default(uuid())
  type           String // IntentType (common/types/intent.ts)
  version        String    @default("1.0")
  participantId  String
  agentId        String?
  parentIntentId String?
  moduleId       String
  payload        Json
  status         String // IntentStatus (core/state-machine.ts)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?
  fulfilledBy    String?
  metadata       Json      @default("{}")

  // CROSS-LAYER-SEMANTIC-CORRECTIVE-1-R4 (2026-09-13) — closes item 37's
  // remaining partial-durability window in `createOffer()`. Some
  // `persist()` implementations (`liquidity.service.ts`'s `persistOffer()`)
  // create an Intent as the FIRST of two independently-durable writes,
  // then a second object (an Offer) referencing it — if the SECOND write
  // fails, a retry must reuse the SAME Intent rather than creating a new
  // one. `idempotencyClaimId` is that Intent's own idempotency-claim
  // identity, set to the ORIGINATING `IdempotencyKey` row's own `id`
  // (never the caller-supplied string itself, which is only unique
  // within one (scope, participantId) pair, not globally) at the exact
  // moment this row is inserted — the SAME statement that creates the
  // Intent, not a separate follow-up write, so there is no window at all
  // between "Intent exists" and "its claim marker is durable." A retry
  // looks this column up directly (`IntentRepository.findByIdempotencyClaimId()`)
  // BEFORE attempting to create a new Intent — durable truth from a
  // single already-committed row, never dependent on any OTHER table's
  // bookkeeping succeeding. `@unique` is real defense-in-depth, not just
  // documentation: even a genuine concurrent double-attempt (two
  // application instances racing on the same reclaimed claim) can only
  // ever let ONE `prisma.intent.create()` with a given
  // `idempotencyClaimId` actually land; the loser sees Postgres's own
  // P2002 and reconciles via the same column, the identical "insert-as-
  // lock, catch P2002, look up the winner" idiom `IdempotencyKey.claim()`
  // itself already uses. `null` for every Intent created outside this
  // idempotency-protected path (the overwhelming majority — Trade/other
  // Intent-creating flows never pass one).
  idempotencyClaimId String? @unique

  events IntentEvent[]
  // RFC-018 — back-relations for Offer.intentId/Trade.intentId above.
  // Modeled as arrays since that's the FK direction Prisma requires, but
  // the two sides are NOT symmetric, confirmed by direct code
  // inspection (CROSS-LAYER-SEMANTIC-CORRECTIVE-1-R5, 2026-09-14):
  // - `offers`: at most ONE Offer per Intent, genuinely, not just "in
  //   practice" — `Offer.intentId` carries a real `@unique` constraint.
  //   Every `createOffer()` call creates a brand-new Intent; the only
  //   way two Offer rows could share one Intent is `persistOffer()`'s
  //   own idempotent-retry reconciliation, which by definition IS the
  //   same logical attempt.
  // - `trades`: MULTIPLE Trades legitimately share one Intent, via the
  //   Intent's owning Offer — `Offer.status` never leaves `ACTIVE` just
  //   because one Trade was created against it (`trade.service.ts`'s own
  //   `createTradeUncached()`), so a still-`ACTIVE` offer can
  //   legitimately accumulate more than one real Trade, each carrying
  //   the SAME `offer.intentId`. `Trade.intentId` is deliberately NOT
  //   unique — this asymmetry with `Offer.intentId` is intentional, not
  //   an oversight (the original item 37 investigation already rejected
  //   a composite-business-key uniqueness constraint on Trade creation
  //   for exactly this reason — see `src/common/idempotency.ts`'s own
  //   header).
  offers Offer[]
  trades Trade[]

  @@index([participantId])
  @@index([status])
  @@map("intents")
}

// IntentEvent is Intent's own audit trail — the same per-module-owned-table
// pattern EscrowEvent/ReputationEvent already established, not a second
// "Timeline" table (RFC-008 D5 already rejected a dedicated Timeline table
// in favor of per-module event tables Timeline projects over — this is one
// more of those, not a competing design). entryHash/prevHash are RFC-008
// D2's hash-chaining design (rfcs/RFC-008-verifiable-timestamps-and-chained-timeline.md)
// implemented here first — EscrowEvent/ReputationEvent still don't have it
// (BACKLOG.md: 🔲 Not started), this table picks that design up rather than
// inventing an unlinked event log the same gap RFC-008 already diagnosed.
model IntentEvent {
  id          String   @id @default(uuid())
  intentId    String
  intent      Intent   @relation(fields: [intentId], references: [id])
  fromStatus  String?
  toStatus    String
  triggeredBy String
  note        String?
  createdAt   DateTime @default(now())
  entryHash   String? // sha256(fromStatus+toStatus+triggeredBy+prevHash), computed at write time
  prevHash    String? // prior IntentEvent.entryHash for this intentId; 'genesis' for the first

  // RELATORIO_PERFORMANCE.md, closed 2026-08-08 — writeIntentEvent()'s
  // hot path does findFirst(where: { intentId }, orderBy: { createdAt:
  // 'desc' }) on every single transition (to read the prior entryHash for
  // the hash chain); the plain [intentId] index above still needs a
  // separate sort step for that. Composite index lets it be satisfied
  // directly.
  @@index([intentId, createdAt])
  @@map("intent_events")
}

// RFC-008 D2 amendment (Missão 05.7, 2026-08-15) — the durable backing
// store for EventStore's DurableEvent stream (common/events/event-store.ts).
// One shared table, not a per-module one like EscrowEvent/IntentEvent
// above: this IS the EventStore's own storage, the same generic stream
// Timeline (core/timeline.ts) has read via EventStore.getEvents(correlationId)
// since RFC-017 — not a second, competing copy of any one module's audit
// trail. Closes the gap the 2026-08-04 D2 note and the Missão 05.5
// EscrowEvent amendment both disclosed and deferred: the hash-chained
// DurableEvent stream lived only in InMemoryEventStore, gone on restart.
model DurableEventRecord {
  id            String @id @default(uuid())
  eventName     String
  correlationId String
  // @db.Json (Postgres `json`, not the default `jsonb`), on purpose —
  // Missão 06 (2026-08-16) real-Postgres integration testing found
  // `jsonb`'s binary storage does not preserve object key order (a
  // confirmed, reproduced fact, not a guess: a payload written as
  // {escrowId, tradeId, from, to, triggeredBy} read back as {to, from,
  // tradeId, escrowId, triggeredBy}), which silently broke
  // `entryHash` verification — `computeEntryHash()` hashes
  // `JSON.stringify(payload)`, so a payload reordered on the way back
  // out of storage recomputes to a different hash than what was stored
  // at write time, even though nothing was actually tampered with.
  // Postgres's plain `json` type stores the exact submitted text
  // verbatim (validated, never reparsed/canonicalized), which is what
  // this column needs. No change to `computeEntryHash()` itself or to
  // RFC-008's hash formula — this is a storage-layer fix, not a
  // protocol one. Costs `jsonb`'s native indexing/query operators on
  // this column, unused today (every reader takes the whole payload,
  // never queries into its structure).
  payload       Json   @db.Json
  // The exact ISO-8601 string computeEntryHash() hashed at write time —
  // never a native DateTime column. A DateTime column would round-trip
  // through a JS Date object on every read, a real and avoidable risk of
  // the recomputed hash silently disagreeing with what was stored.
  // ISO-8601's own format still sorts correctly under a plain
  // lexicographic ORDER BY, so ordering doesn't need a native type either.
  publishedAt   String
  entryHash     String
  prevHash      String

  // Same hot-path shape IntentEvent/EscrowEvent already established:
  // publish() reads the last event for a correlationId before writing the
  // next one (to chain prevHash); getEvents()/Timeline reads the full
  // ordered history for one correlationId.
  @@index([correlationId, publishedAt])
  @@map("durable_events")
}

model Message {
  id        String    @id @default(uuid())
  tradeId   String
  trade     Trade     @relation(fields: [tradeId], references: [id])
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id])
  content   String
  msgType   String    @default("TEXT")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tradeId])
  @@map("messages")
}

model ReputationEvent {
  id              String   @id @default(uuid())
  tradeId         String
  trade           Trade    @relation(fields: [tradeId], references: [id])
  raterId         String
  rater           User     @relation("RaterEvents", fields: [raterId], references: [id])
  ratedId         String
  rated           User     @relation("RatedEvents", fields: [ratedId], references: [id])
  score           Int
  comment         String?
  moduleId        String   @default("openreputation")
  protocolVersion String   @default("0.1")
  createdAt       DateTime @default(now())

  @@unique([tradeId, raterId])
  @@map("reputation_events")
}

// Capability Registry — PROTOCOL_SPECIFICATION.md §1.10,
// rfcs/RFC-005-capability-model.md (CapabilityGrant shape),
// rfcs/RFC-013-capability-registry-and-wallet-adapter.md (this table,
// first real persistence — core/capability-registry.ts was a stub with
// no table before this). Only CapabilityGrant (the permission side) is
// persisted here; Capability/CapabilityImplementation (the static
// moduleId <-> capabilityName mapping, RFC-005's own illustrative table)
// stays an in-code map in capability-registry.ts, per that RFC's
// Alternatives Considered — no real write path exists for it yet.
model CapabilityGrant {
  id             String    @id @default(uuid())
  grantedTo      String // a Participant or Agent id (RFC-001)
  capabilityName String // e.g. 'trade-coordination' (RFC-005's table)
  scope          String[] // subset of that capability's events/API
  constraints    Json? // e.g. { maxValue, expiresAt }
  issuedBy       String
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([grantedTo])
  @@index([capabilityName])
  @@map("capability_grants")
}

// ADR-004 — durable authorization committed at the Execution Commit Gate.
// This is intentionally NOT a child of EscrowPendingTransaction: successful
// finalization deletes the pending row, while this evidence must survive for
// retry/recovery/audit. Source ids are stored as immutable historical facts,
// not cascading relations, so later lifecycle cleanup cannot erase authority
// provenance that already governed an economic attempt.
model CapabilityExecutionAuthorization {
  id                String   @id @default(uuid())
  pendingOperationId String   @unique
  escrowId           String
  grantId            String
  grantedTo          String
  capabilityName     String
  requiredScope      String
  constraints        Json?
  operationDigest    String
  authorizedAt       DateTime @default(now())

  @@index([escrowId])
  @@index([grantId])
  @@map("capability_execution_authorizations")
}

// Two-Person Control for Escrow Release — rfcs/RFC-015-dual-authorization-escrow-release.md.
// Application-layer maker-checker control, NOT on-chain multisig: WDK's
// real package (@tetherto/wdk-wallet-evm-erc-4337) is single-owner-only
// (checked against its actual compiled types before choosing this design,
// see that RFC's Motivation) — one seed still signs the eventual transfer.
// What this table adds is a real, persisted gate *before* that seed is
// ever asked to sign: both of a trade's own two counterparties
// (Trade.buyerId, Trade.sellerId) must independently record approval
// before escrow.service.ts's releaseFunds() will proceed on the normal
// (non-disputed) path. Arbitrated releases (Escrow.status === 'DISPUTED')
// intentionally bypass this — see that RFC's Decision §3.

model EscrowReleaseApproval {
  id         String   @id @default(uuid())
  escrowId   String
  escrow     Escrow   @relation(fields: [escrowId], references: [id])
  // Missão 07.6.3 (R3): this field's own FK has always existed at the
  // database level (present in the very first migration) — this comment
  // used to claim otherwise. Corrected: escrowId is real DB-enforced
  // referential integrity; the check below is a separate, additional
  // domain-level validation the FK alone can't express.
  approverId String // must equal the trade's buyerId or sellerId — enforced in escrow.service.ts
  approvedAt DateTime @default(now())

  @@unique([escrowId, approverId])
  @@index([escrowId])
  @@map("escrow_release_approvals")
}

// Client-held keys for MULTISIG/LIGHTNING_HODL escrow — the genuine
// HodlHodl-grade non-custody upgrade (2026-07-27). Before this,
// multisig.provider.ts/lightning-hodl.provider.ts derived ALL 3 keys
// (buyer/seller/arbiter) from one server-held seed; now the buyer and
// seller each generate their own key client-side and submit only the
// public key here — the server never sees their private key, only
// derives its own arbiter key. Same table shape as EscrowReleaseApproval
// above (per-escrow, per-role row, unique-constrained, upsert-idempotent),
// with a real payload since "which pubkey" — unlike "did X approve" — is
// not a boolean.
model EscrowParticipantKey {
  id                String   @id @default(uuid())
  escrowId          String
  escrow            Escrow   @relation(fields: [escrowId], references: [id])
  // Missão 07.6.3 (R3): same correction as EscrowReleaseApproval.escrowId
  // above — the FK to escrows(id) is real and has existed since the
  // first migration; only the domain check below (role must match the
  // trade's own buyer/seller) is application-level, not this field's
  // referential integrity.
  //
  // Missão 11 Fase 5.2 — a third role, 'arbiter', was added to this SAME
  // table rather than a new column/table (chosen over a dedicated
  // Escrow.arbiterPubkeyHex column after reading this model's own
  // @@unique([escrowId, role]) and mapParticipantKeysShape() first, per
  // the Fase 5.2 report's own storage-model reasoning): it already gives
  // per-escrow-per-role uniqueness, and the existing authenticated GET
  // /v1/settlement/escrow/:id response already returns participantKeys
  // verbatim, so an arbiter row is exposed to the escrow's own
  // buyer/seller/assigned-arbiter with ZERO route/DTO changes. For an
  // 'arbiter' row, participantId is the arbiter's TRUSTED_ARBITRATORS
  // identity string (the same identity space as Dispute.arbiterId, NOT a
  // trade party id), written ONCE, server-side, by
  // escrow.service.ts's submitParticipantKey() at first-script-build
  // time (never by the client-facing submit-key route, which only ever
  // upserts 'buyer'/'seller'). Write-once: enforced at the DB level by
  // escrow_participant_keys_arbiter_immutability_guard (see this
  // migration's own comment) — UPDATE/DELETE of an existing 'arbiter' row
  // is rejected by Postgres itself, not just application discipline. A
  // legacy escrow (created before this phase) has no 'arbiter' row at
  // all — MultisigProvider.partiesFor() falls back to live derivation for
  // those, unchanged from before this phase (no fake backfill was ever
  // performed to manufacture one).
  role              String // 'buyer' | 'seller' | 'arbiter' — buyer/seller must match the trade's own buyerId/sellerId, enforced in escrow.service.ts; arbiter is write-once, DB-enforced (see above)
  participantId     String
  // 33-byte compressed secp256k1 pubkey, hex (66 chars) — the canonical
  // submitted format. MultisigProvider's P2WSH/OP_CHECKMULTISIG script
  // uses it as-is; LightningHodlProvider's Arkade Taproot script derives
  // the 32-byte x-only form by stripping the leading parity byte (same
  // point, different serialization — verified experimentally before this
  // model was written, see multisig.provider.ts/lightning-hodl.provider.ts's
  // own header comments for the full disclosure).
  pubkey            String
  // Missão 11 Fase 9.1 §4/§5 — self-declared client capability profile
  // (see capability-profile.ts's own header comment for the full design).
  // NULL means "not declared" (grandfathered, see that file's disclosed
  // backward-compatibility decision), never "declared empty" — a client
  // either states a real, recognized profile string or says nothing.
  // Only meaningful for buyer/seller rows; the server-written 'arbiter'
  // row below never sets this (the arbiter key is server-derived, not a
  // client wallet whose implementation completeness is in question).
  capabilityProfile String?
  createdAt         DateTime @default(now())

  @@unique([escrowId, role])
  @@index([escrowId])
  @@map("escrow_participant_keys")
}

// Phase 2 of the client-held-keys upgrade (2026-07-27) — signature
// collection for MULTISIG release/refund. Once buyer/seller keys became
// client-held (EscrowParticipantKey above), multisig.provider.ts could no
// longer sign a release/refund server-side in one synchronous call; this
// pair of tables tracks the in-flight signing round instead: the server
// builds one unsigned PSBT (escrow.service.ts's initiateRelease()/
// initiateRefund()), each required party independently signs their own
// copy client-side and submits it back (submitTransactionSignature()) —
// verified experimentally that bitcoinjs-lib's Psbt.combine() correctly
// merges independently-signed copies of the same unsigned PSBT before
// this was written. Cleared (deleted, cascading to its signatures) once
// finalize succeeds — a completed release/refund leaves no pending row
// behind, only Escrow.txReleaseId as the durable record.
model EscrowPendingTransaction {
  id                  String   @id @default(uuid())
  escrowId            String   @unique
  // Missão 07.6.3 (R3): this FK to escrows(id) has existed at the
  // database level since the first migration — declaring it here just
  // makes schema.prisma match reality. `@unique` above (already
  // present) is what makes this a real one-to-one relation — at most
  // one in-flight signature-collection round per escrow.
  escrow              Escrow   @relation(fields: [escrowId], references: [id])
  kind                String // 'release' | 'refund' | 'split'
  toAddress           String
  // Only set for kind='split' — the seller's payout address, alongside
  // toAddress (buyer's) above. A split PSBT has two real outputs, unlike
  // release/refund's one, so it needs a second address column rather than
  // reusing toAddress twice.
  toAddressSecondary  String?
  // Missão 11 Fase 3 — real gap found wiring FeeObligation into the
  // signature-collection finalize path: initiateSplit() validated and used
  // buyerBps to build the PSBT, but never persisted it anywhere, so
  // submitTransactionSignature() (which can run much later, once all
  // signatures arrive) had no way to compute the seller's basisAmount for
  // a SPLIT settled via this path. Only set for kind='split'.
  buyerBps            Int?
  // Missão 11 Fase 4 §J — the fee-collection decision the provider ACTUALLY
  // built into unsignedPsbtBase64 at construction time (multisig.provider.ts's
  // buildUnsignedRelease()/buildUnsignedSplit()), persisted so
  // submitTransactionSignature() (which can finalize long after this row
  // was created) records a FeeObligation that is guaranteed to match the
  // real transaction rather than an independent, possibly-diverging
  // recomputation. Null for a legacy (non-policy-aware) escrow or a
  // provider that doesn't yet implement fee-aware construction.
  feeCollectionSats   Int?
  feeCollectionWaived Boolean?
  // Missão 11 Fase 9.1.1 §3 — the exact miner-fee amount (satoshis) this
  // PSBT was actually built against (multisig.provider.ts's own
  // estimateFeeSats(), computed once at construction time from a
  // fee-rate query no client can retroactively reproduce). Persisted for
  // the same reason feeCollectionSats is: without it, an independent
  // verifier (sails-ui, or any external wallet) has no reliable way to
  // know what miner fee to EXPECT when reconstructing this PSBT's
  // ExpectedSigningIntent — re-estimating live at verification time would
  // almost always disagree with the real, historical value baked into
  // the already-built PSBT, causing legitimate transactions to spuriously
  // fail independent verification. Null only for a provider/kind that
  // doesn't populate it (kept nullable rather than defaulted, matching
  // feeCollectionSats' own convention, so "not recorded" stays
  // distinguishable from "recorded as zero").
  minerFeeSats        Int?
  unsignedPsbtBase64  String
  // Participant ids who must each submit their own signed copy. On a
  // DISPUTED release/refund this list has only ONE entry (buyer or
  // seller) — the arbiter's own required signature is pre-embedded into
  // unsignedPsbtBase64 above at build time, since the arbiter's key is
  // still server-derived (multisig.provider.ts's own header comment) and
  // never needed a client submission to begin with. A DISPUTED split has
  // only ONE entry too (buyer, by convention — see multisig.provider.ts's
  // buildUnsignedSplit()) — still a 2-of-3 script underneath, so only one
  // more signature can combine with the arbiter's already-embedded one.
  requiredSigners     String[]
  triggeredBy         String
  createdAt           DateTime @default(now())

  // ADR-005 / #218 — durable ruling-generation provenance, snapshotted at
  // the moment a DISPUTED ruling creates this pending operation (never
  // backfilled onto a cooperative, non-disputed release/refund/split —
  // ADR-005 §9 does not redefine that authority, so all six columns stay
  // null for those rows). This is the "what generation authorized this
  // pending operation" fact the Economic Disposition Commit Gate
  // (economic-disposition-authority.ts) re-validates against the LIVE
  // Dispute row immediately before the first provider side effect.
  // rulingAuthoritySignature is the same Ed25519 signature
  // arbitration-authority.ts already verifies at ruling time — reused
  // here as the immutable fingerprint of the exact signed decision, never
  // a separately-invented digest.
  disputeId               String?
  rulingAppealRound       Int?
  rulingArbiterId         String?
  rulingOutcome           DisputeRuling?
  rulingAuthoritySignature String?
  rulingAuthorityIssuedAt DateTime?

  signatures EscrowTransactionSignature[]

  @@map("escrow_pending_transactions")
}

// ADR-005 / #218 — durable authorization committed at the Economic
// Disposition Commit Gate, immediately before the first provider side
// effect for a pending operation that originated from a disputed ruling.
// Mirrors CapabilityExecutionAuthorization's shape and rationale exactly
// (ADR-004 / #211, above in this file): intentionally NOT a child of
// EscrowPendingTransaction, so successful pending-row cleanup cannot erase
// the authority evidence for an economic attempt that already committed.
// Distinct from CapabilityExecutionAuthorization — Economic Disposition
// Authority (does the recorded ruling generation still govern?) and
// Capability/Eligibility Authority (is the actor still permitted?) are
// orthogonal gates; neither substitutes for the other (ADR-005 §7).
model EconomicDispositionAuthorization {
  id                 String   @id @default(uuid())
  pendingOperationId String   @unique
  escrowId           String
  disputeId          String
  appealRound        Int
  arbiterId          String
  ruling             DisputeRuling
  operationDigest    String
  authorizedAt       DateTime @default(now())

  @@index([escrowId])
  @@index([disputeId])
  @@map("economic_disposition_authorizations")
}

model EscrowTransactionSignature {
  id               String                   @id @default(uuid())
  pendingTxId      String
  pendingTx        EscrowPendingTransaction @relation(fields: [pendingTxId], references: [id], onDelete: Cascade)
  participantId    String
  signedPsbtBase64 String
  createdAt        DateTime                 @default(now())

  @@unique([pendingTxId, participantId])
  @@index([pendingTxId])
  @@map("escrow_transaction_signatures")
}

enum VerificationVerdict {
  ACCEPTED
  REJECTED
}

// Sails OpenProof — Claim/Proof/Verification (PROTOCOL_SPECIFICATION.md
// §1.8, RFC-006). This pass builds the core three-table shape plus the
// specific hash/nonce/time-lock properties Fase 1's Red Team review asked
// for; it deliberately does NOT build RFC-007's ProofRegistry (duplicate-
// evidence detection), EvidenceProvider (external media storage adapter —
// `evidence` is stored inline here, not yet routed through Nostr.build/S3/
// IPFS/etc.), or RFC-008's AnchorProof/TimestampAnchor — those remain
// 📋 Planned, unbuilt, same as before this pass.
model Claim {
  id        String   @id @default(uuid())
  claimedBy String // a Participant id (RFC-001)
  claimType String // open string — e.g. 'payment_sent', 'keypair_control', 'collateral_held'
  assertion Json // e.g. { amount: "500", currency: "BRL" }
  // RFC-007 D6's EvidenceBundle needs a real, queryable scope to
  // aggregate "every Claim for this trade" — nullable because not every
  // Claim is trade-related (this mirrors, and is corrected the same way
  // as, core/timeline.ts's own real-world finding: RFC-007's literal
  // `intentId` is barely populated today, `tradeId` is the value every
  // real trade-lifecycle event actually carries — see that file's own
  // header comment for the full precedent this follows).
  tradeId   String?
  createdAt DateTime @default(now())

  proofs Proof[]

  @@index([claimedBy])
  @@index([tradeId])
  @@map("claims")
}

// evidenceHash is ALWAYS computed server-side from `evidence` by
// proof.service.ts's submitProof() — a caller-submitted hash is never
// trusted or persisted as-is (the exact gap Fase 1 Task 3 exists to
// close). `evidence` is stored inline (see model-level comment above for
// why that's a deliberate, disclosed scope limit, not an oversight).
model Proof {
  id           String   @id @default(uuid())
  claimId      String
  claim        Claim    @relation(fields: [claimId], references: [id])
  evidence     Json
  evidenceHash String // sha256 hex of the canonicalized `evidence`, recomputed server-side — never client-supplied
  submittedBy  String
  submittedAt  DateTime @default(now())

  verifications      Verification[]
  evidenceReferences EvidenceReference[]

  @@index([claimId])
  @@index([evidenceHash]) // RFC-007 D1 — ProofRegistry.findDuplicates() queries by this
  @@map("proofs")
}

// RFC-007 D2 — closed 2026-08-04. The protocol never stores media itself;
// this is the reference — a real EvidenceProvider (evidence-provider.ts)
// persists the actual bytes wherever it's configured to (local disk by
// default, S3/R2/IPFS/Arweave are real, pluggable alternatives per that
// file's own header comment), and this row is the only thing OpenProof
// itself ever holds: where it is, its hash, who signed it. `anchorProof`
// (RFC-008 D1) is optional and additive — most EvidenceReferences never
// get one, Policy Engine decides when the extra assurance is worth the
// real cost (a real Bitcoin-anchored OpenTimestamps submission).
// Issue #265 CTO Gate R2, CONTRACT DELTA 5 — provider + uri are set once
// at creation (proof.service.ts's attachEvidence()) and MUST NEVER be
// updated in place. This model is already the smallest immutable-history
// design consistent with the architecture: `Proof.evidenceReferences` is
// a one-to-many relation, so a future provider migration (e.g. moving
// existing local-fs-stored bytes to s3) belongs as a NEW row pointing at
// the new location — never an UPDATE overwriting an old row's own
// provider/uri, which would silently destroy that row's storage
// provenance. proof.service.ts's own anchorEvidence() is the only
// mutation this model's rows ever undergo, and it touches anchorProof
// only (guarded by a regression test in tests/proofService.test.ts) — no
// migration subsystem exists or is needed today; this comment is the
// durable constraint for whenever one is.
model EvidenceReference {
  id          String   @id @default(uuid())
  proofId     String
  proof       Proof    @relation(fields: [proofId], references: [id])
  provider    String // e.g. 'local-fs', 's3', 'r2', 'ipfs', 'arweave', 'nostr.build' — immutable once set, see model comment above
  uri         String // immutable once set, see model comment above
  sha256      String // real hash of the stored media bytes — recomputed server-side, same discipline as Proof.evidenceHash
  mimeType    String
  signature   String // signed by the submitting Participant's key
  anchorProof Json? // RFC-008 D1 — { anchorType, anchorId, submittedAt, upgraded } once/if anchored; null until then
  createdAt   DateTime @default(now())

  @@index([proofId])
  @@map("evidence_references")
}

// verifiedBy may be a Participant, an assigned Arbiter, or a QVAC agent
// label (same `agent:{label}:{participantId}` shape escrow.service.ts's
// isPartyOrAgent() already uses) — never trusted as an identity claim on
// its own; callers reach this through routes that already authenticated
// the caller, the same boundary every other mutating route in this
// codebase relies on (requireAuth, never a bare id in the body).
model Verification {
  id         String              @id @default(uuid())
  proofId    String
  proof      Proof               @relation(fields: [proofId], references: [id])
  verifiedBy String
  verdict    VerificationVerdict
  reason     String?
  verifiedAt DateTime            @default(now())

  @@index([proofId])
  @@map("verifications")
}

// CROSS-LAYER-SEMANTIC-CORRECTIVE-1 (item 37, 2026-09-13) — the smallest
// reusable seam for "one logical economic-coordination action must not
// become multiple because transport was uncertain": a client-supplied
// key, scoped per-caller and per-operation, claimed atomically via this
// table's own unique constraint (the same insert-as-lock idiom
// `escrow-pending-tx.ts`'s P2002 handling already uses for a different
// resource). Deliberately NOT a composite business-key uniqueness
// constraint (e.g. `(offerId, counterpartyId)` for trade creation) —
// the audit that registered this item found that would incorrectly
// reject a genuinely new, separate trade the same buyer legitimately
// intends against the same still-ACTIVE offer at a later time
// (`Offer.status` never transitions away from `ACTIVE` just because one
// trade was created against it). Only a caller-supplied key can express
// "this specific attempt," independent of what the request happens to
// contain.
//
// `requestHash` lets a reused key be rejected as a genuine client bug
// (reusing one key for two different logical requests) rather than
// silently replaying the wrong result. `resultRef` is the created
// resource's own id — recovery re-fetches that resource through the
// normal repository, this table never duplicates its content.
//
// CROSS-LAYER-SEMANTIC-CORRECTIVE-1-R1 (2026-09-13) — `status` now
// distinguishes FOUR real states, not three. The original three-state
// design conflated two genuinely different failure domains: "create()
// itself threw, nothing durable exists yet" (truly `FAILED`, safe to
// retry) and "create() SUCCEEDED but the write recording that success
// failed" (a real durable side effect exists; retrying would duplicate
// it). `UNKNOWN` is that second case, named after this codebase's own
// governing principle — Absence ≠ Failure ≠ Unknown — applied here to
// the idempotency record itself, not just to a settlement outcome.
// - `IN_PROGRESS` — a genuine race, not yet resolved; the second caller
//   must not proceed, and must not be told anything succeeded or failed.
// - `COMPLETED` — create() succeeded AND this row was durably updated to
//   say so. A safe, exact replay via `resultRef`.
// - `UNKNOWN` — create() succeeded (a durable side effect genuinely
//   exists, `resultRef` is set) but the write finalizing this record as
//   `COMPLETED` itself failed. Treated identically to `COMPLETED` for
//   replay purposes (recover via `resultRef`, never re-run create()) —
//   the ONLY thing unknown is whether this bookkeeping row itself says
//   so cleanly, never whether the business action happened. See
//   `src/common/idempotency.ts`'s `runAndSettle()` for the exact
//   sequencing this depends on.
// - `FAILED` — create() itself threw; no durable side effect was ever
//   produced. Safe to retry, but ONLY via the atomic `FAILED ->
//   IN_PROGRESS` compare-and-swap `reclaimFailed()` performs — never a
//   plain read-then-write, which would let two concurrent retries both
//   observe `FAILED` and both execute create() (CROSS-LAYER-SEMANTIC-
//   CORRECTIVE-1-R1's own Defect B).
enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  UNKNOWN
  FAILED
}

model IdempotencyKey {
  id            String               @id @default(uuid())
  scope         String // e.g. 'openp2p.trade.create', 'liquidity.offer.create', 'settlement.dispute.evidence' — never a table/model name, a logical-operation name
  participantId String // the caller — a key is only ever meaningful scoped to who used it, never globally unique on its own
  key           String // the client-supplied idempotency key itself
  requestHash   String // sha256 of the semantically-relevant request payload — see src/common/idempotency.ts
  status        IdempotencyKeyStatus @default(IN_PROGRESS)
  resultRef     String? // the created resource's own id — set once status = COMPLETED or UNKNOWN (never FAILED/IN_PROGRESS)
  // CROSS-LAYER-SEMANTIC-CORRECTIVE-1-R3 (2026-09-13) introduced a
  // `checkpointRef` column here — a mid-persist() checkpoint a multi-
  // write persist() could record before its second write. R4 (2026-09-13,
  // CTO review) found that mechanism itself unsafe: `checkpointRef`
  // required its OWN separate write (`setCheckpoint()`) to succeed, and
  // that write could itself fail definitely OR ambiguously (committed
  // but the acknowledgement lost) — reintroducing the exact "a failed
  // call is not proof of no side effect" defect one level deeper, now
  // against the checkpoint write itself. REMOVED, superseded by a
  // strictly stronger mechanism that needs no separate bookkeeping write
  // at all: the durable object a multi-write persist() creates first
  // (e.g. an Intent) now carries its own idempotency-claim marker,
  // written atomically as part of the SAME insert that creates it — see
  // `Intent.idempotencyClaimId` below and `liquidity.service.ts`'s
  // `persistOffer()`. No code references `checkpointRef` any more; this
  // model never shipped with it in production.
  createdAt     DateTime             @default(now())
  completedAt   DateTime?

  // The atomic claim primitive this whole mechanism depends on — a
  // second `create()` for the same (scope, participantId, key) fails
  // with Postgres's real unique-violation (P2002), which is how a
  // concurrent or retried caller is told "someone already claimed this."
  @@unique([scope, participantId, key])
  @@map("idempotency_keys")
}

// Issue #298 - durable delivery/replay identity for event-derived projections
// (see migration 20260921121000_event_projection_claims for the full reasoning;
// eventId intentionally has no FK to durable_events). Written only through
// applyEventProjectionOnce() (src/common/events/event-projection.ts), in the
// same transaction as the mutation it guards.
model EventProjectionClaim {
  id            String   @id @default(uuid())
  eventId       String
  projectionKey String
  subjectId     String
  appliedAt     DateTime @default(now())

  @@unique([eventId, projectionKey, subjectId], map: "event_projection_claim_identity_key")
  @@index([projectionKey, subjectId])
  @@map("event_projection_claims")
}

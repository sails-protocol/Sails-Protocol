# Sails UI build-time settings. Vite inlines VITE_* values into the bundle at build time:
# change them and rebuild; they are public (never put a secret here).

# Address of the nó Sails API this UI talks to (lib/sailsClient.ts).
# Unset: http://localhost:3000 (the local backend).
# Homologation VPS example: VITE_API_BASE_URL=https://node.example.org
VITE_API_BASE_URL=http://localhost:3000

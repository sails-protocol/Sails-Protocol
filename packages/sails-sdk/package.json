{
  "name": "@satsails/p2p-trading-sdk",
  "version": "0.2.0",
  "description": "Sails P2P Trading SDK — the single typed client a wallet/fintech imports to reach every Sails Protocol module (OpenIdentity, OpenLiquidity, OpenP2P, OpenSettlement, OpenReputation) over HTTP/WebSocket. See docs/SDK_GUIDE.md.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alan-schramm/Sails-Protocol.git",
    "directory": "packages/sails-sdk"
  },
  "keywords": [
    "sails",
    "p2p",
    "bitcoin",
    "escrow",
    "non-custodial",
    "sdk"
  ],
  "dependencies": {
    "@arkade-os/sdk": "^0.4.66",
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@satsails/p2p-schemas": "^0.2.0",
    "@scure/bip32": "^2.0.1",
    "@scure/btc-signer": "^2.0.1",
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^3.0.1",
    "ed2curve": "^0.3.0",
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": "^3.1119.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-kms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.1119.0",
    "@types/ed2curve": "^0.2.4",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  }
}

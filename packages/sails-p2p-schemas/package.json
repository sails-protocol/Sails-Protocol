{
  "name": "@satsails/p2p-schemas",
  "version": "0.2.0",
  "description": "Sails P2P Trading domain schemas — Offer, Trade, Dispute contracts shared by every wallet/SDK integration (the 'contrato social' layer between Sails Core and any P2P trading interface)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alan-schramm/Sails-Protocol.git",
    "directory": "packages/sails-p2p-schemas"
  },
  "keywords": [
    "sails",
    "p2p",
    "bitcoin",
    "escrow",
    "non-custodial",
    "sdk"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}

{
  "name": "satsails-p2p-protocol",
  "version": "0.1.1",
  "description": "Economic Coordination Protocol and reference implementation for interoperable P2P financial marketplaces",
  "main": "dist/src/main.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alan-schramm/Sails-Protocol.git"
  },
  "keywords": [
    "sails",
    "economic-coordination",
    "p2p",
    "financial-marketplace",
    "bitcoin",
    "stablecoins",
    "non-custodial",
    "protocol",
    "sdk",
    "fintech"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "contracts"
  ],
  "scripts": {
    "build": "npm run build -w @sails/core && npm run build -w @satsails/p2p-schemas && npm run build -w @satsails/p2p-trading-sdk && tsc",
    "start": "node dist/src/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "prepare": "husky install",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "check:core-boundary": "ts-node scripts/check-core-boundary.ts packages/sails-core/src",
    "check:conformance": "ts-node scripts/run-conformance-harness.ts",
    "db:local:start": "node scripts/local-postgres.js start",
    "db:local:stop": "node scripts/local-postgres.js stop",
    "redis:local:start": "node scripts/local-redis.js start",
    "redis:local:stop": "node scripts/local-redis.js stop",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:completeness-check": "npx prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "ts-node src/test/seeds/seed.ts",
    "economics:publish-policy": "ts-node scripts/publish-economic-policy.ts",
    "economics:draft-policy": "ts-node scripts/draft-economic-policy.ts",
    "db:studio": "npx prisma studio",
    "demo:pix-to-usdt": "ts-node --transpile-only examples/demo/pix-to-usdt-flow.ts",
    "demo:qvac": "ts-node --transpile-only examples/demo/demo-satsails-qvac.ts",
    "demo:multisig": "ts-node --transpile-only examples/demo/multisig-testnet-flow.ts",
    "test": "npm run test:unit && npm run test:integration:postgres",
    "test:unit": "jest --maxWorkers=50% --testPathIgnorePatterns=\"/node_modules/|tests/integration/(atomicCollectionRecognition|collectedTimeDistributionFreeze|custodyAttestationFoundation|dbNativeInvariants|disputeOutcomeMultisigLive|distributionEntitlementFoundation|draftEconomicPolicyOperatorCli|economicDispositionAuthorityConcurrency|economicPolicyExclusivity|economicPolicyOperatorCli|escrowArbiterCommitmentIntegration|escrowFundingConcurrency|escrowFundingUncertainty|escrowTimelockExpiryAuthority|expiryRecoveryStateMachine|feeAccountingFoundation|feeCollectionRecognitionIntegration|feeObligationSettlementLifecycle|feePolicyImmutability|feeSnapshotPreFundingIntegration|legacyFeeDistributionWriteFreeze|capabilityAuthorityEnforced|capabilityOnboardingConcurrency|m9fReleaseReorg|m9rClaimRecovery|m9rDispatchRecovery|multisigDustPolicyIntegration|multisigOutpointIntegrity|offerEnvelopePersistenceRoundTrip|offerIntentIdempotencyUniqueness|postgresProductionReadiness|registrationProofOfPossessionLive|semanticTransitionRecordAtomicity)\\.test\\.ts$\"",
    "test:integration:postgres": "jest --runInBand tests/integration/atomicCollectionRecognition.test.ts tests/integration/capabilityAuthorityEnforced.test.ts tests/integration/capabilityOnboardingConcurrency.test.ts tests/integration/collectedTimeDistributionFreeze.test.ts tests/integration/custodyAttestationFoundation.test.ts tests/integration/dbNativeInvariants.test.ts tests/integration/disputeOutcomeMultisigLive.test.ts tests/integration/distributionEntitlementFoundation.test.ts tests/integration/draftEconomicPolicyOperatorCli.test.ts tests/integration/economicDispositionAuthorityConcurrency.test.ts tests/integration/economicPolicyExclusivity.test.ts tests/integration/economicPolicyOperatorCli.test.ts tests/integration/escrowArbiterCommitmentIntegration.test.ts tests/integration/escrowFundingConcurrency.test.ts tests/integration/escrowFundingUncertainty.test.ts tests/integration/escrowTimelockExpiryAuthority.test.ts tests/integration/expiryRecoveryStateMachine.test.ts tests/integration/feeAccountingFoundation.test.ts tests/integration/feeCollectionRecognitionIntegration.test.ts tests/integration/feeObligationSettlementLifecycle.test.ts tests/integration/feePolicyImmutability.test.ts tests/integration/feeSnapshotPreFundingIntegration.test.ts tests/integration/legacyFeeDistributionWriteFreeze.test.ts tests/integration/m9fReleaseReorg.test.ts tests/integration/m9rClaimRecovery.test.ts tests/integration/m9rDispatchRecovery.test.ts tests/integration/multisigDustPolicyIntegration.test.ts tests/integration/multisigOutpointIntegrity.test.ts tests/integration/offerEnvelopePersistenceRoundTrip.test.ts tests/integration/offerIntentIdempotencyUniqueness.test.ts tests/integration/postgresProductionReadiness.test.ts tests/integration/registrationProofOfPossessionLive.test.ts tests/integration/semanticTransitionRecordAtomicity.test.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "dev:ui": "npm run dev -w @sails/ui",
    "build:ui": "npm run build -w @sails/ui",
    "loadtest:intent": "artillery run load-tests/artillery/intent-api.yml",
    "loadtest:ws:prep": "node load-tests/artillery/pregenerate-users.js 50",
    "loadtest:ws": "artillery run load-tests/artillery/chat-ws.yml",
    "loadtest:sdk": "ts-node --transpile-only scripts/sdk-pressure-test.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "^0.4.66",
    "@aws-sdk/client-kms": "^3.1119.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@noble/curves": "^1.2.0",
    "@noble/hashes": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@qvac/sdk": "^0.15.0",
    "@sails/core": "0.0.0",
    "@satsails/p2p-schemas": "^0.2.0",
    "@satsails/p2p-trading-sdk": "^0.2.0",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.15",
    "@types/pg": "^8.23.1",
    "b4a": "^1.8.1",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.1",
    "dotenv": "^17.4.2",
    "ecpair": "^3.0.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "hyperdht": "^6.33.2",
    "hyperswarm": "^4.17.0",
    "ioredis": "^5.3.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sodium-native": "^5.1.0",
    "tiny-secp256k1": "^2.2.4",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/sodium-native": "^2.3.9",
    "@types/ws": "^8.18.1",
    "artillery": "^2.0.33",
    "embedded-postgres": "^18.4.0-beta.17",
    "husky": "^9.0.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "redis-memory-server": "^0.17.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "find-my-way": "^9.7.0",
    "brace-expansion": "^5.0.8",
    "tar": "^7.5.22",
    "valibot": "^1.4.2",
    "uuid": "^11.1.1",
    "react-router": "8.3.0"
  }
}

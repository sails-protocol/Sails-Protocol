# Sails Protocol — Satsails Reference Implementation
# Copy to .env and fill in real values for local development.
# Every variable here is read in src/config/index.ts — that file is the
# single source of truth if this list and the code ever disagree.

# ── Database / Cache ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/sails_protocol
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── Auth (RED_TEAM_REVIEW.md RT-002) ───────────────────────────────────────
AUTH_CHALLENGE_TTL=120
AUTH_SESSION_TTL=3600

# ── P2P Transport (Pears/HyperDHT) ─────────────────────────────────────────
# Comma-separated host:port pairs. Empty uses the public HyperDHT default.
HYPERDHT_BOOTSTRAP=

# ── Rate Limiting (THREAT_MODEL.md — previously unmitigated, real as of
# @fastify/rate-limit) ──────────────────────────────────────────────────────
# General ceiling, every route, per IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Tighter, independently-tracked ceiling on /v1/identity/challenge and
# /v1/identity/authenticate specifically (RED_TEAM_REVIEW.md RT-002) — a
# credential-stuffing attempt hits these two, not the general API.
# Missão 08B (multi-instance safety, 2026-08-17): this tier moved off
# @fastify/rate-limit's local in-memory store onto a small Redis-shared
# counter (src/common/middleware/redis-rate-limit.ts) so the limit is
# enforced across every instance, not per-instance. RATE_LIMIT_AUTH_WINDOW
# below is now unused (was only ever consumed by the old local-store
# config) — the shared counter's window is RATE_LIMIT_AUTH_WINDOW_MS
# instead (milliseconds, no string-parsing dependency added). Left here,
# still settable, in case a local-store fallback is ever reintroduced.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1 minute
RATE_LIMIT_AUTH_WINDOW_MS=60000
# Tighter ceiling on real-authority mutation routes (dispute open/resolve/
# appeal, capability revoke, agent-intent generation) —
# CTO_DUE_DILIGENCE_REPORT.md A-SEC-05, closed 2026-08-08. Same Missão
# 08B move to a Redis-shared counter as the auth tier above —
# RATE_LIMIT_CRITICAL_WINDOW is unused now, RATE_LIMIT_CRITICAL_WINDOW_MS
# is what actually governs the shared counter's window.
RATE_LIMIT_CRITICAL_MAX=20
RATE_LIMIT_CRITICAL_WINDOW=1 minute
RATE_LIMIT_CRITICAL_WINDOW_MS=60000

# ── CORS (CTO_DUE_DILIGENCE_REPORT.md B-SEC-01, closed 2026-08-08) ─────────
# Comma-separated list of allowed browser origins. Only enforced in
# production (NODE_ENV=production) — non-production stays permissive
# (origin: true) so local onboarding needs no extra config. In production,
# leaving this empty means every cross-origin browser request is denied
# by default (fail closed, not fail open) — set it before deploying any
# real frontend.
CORS_ALLOWED_ORIGINS=

# ── Settlement (RED_TEAM_REVIEW.md RT-001 — read that before touching this) ─
# Refuses to boot in production unless MOCK_ESCROW/MOCK_SETTLEMENT are
# explicitly "false" once a real SettlementProvider exists.
MOCK_ESCROW=true
MOCK_SETTLEMENT=true
DEFAULT_TIMELOCK_HOURS=24

# ── Escrow Timelock Proactive Sweeper (BACKLOG.md P0) ───────────────────────
# escrow.service.ts's lockFunds() always computed a real Escrow.expiresAt,
# but nothing ever read it back — a FUNDS_LOCKED escrow whose counterparty
# never returned stayed locked forever with no automatic path to REFUNDED.
# When true, a background interval (ESCROW_TIMELOCK_SWEEP_INTERVAL_MS)
# calls the existing, already-real refundFunds() for every escrow past its
# own expiresAt. Default false: no test or deployment here has ever run a
# background process that moves funds on a timer — a real behavior change
# to opt into deliberately, not inherit silently.
ESCROW_TIMELOCK_SWEEPER=false
ESCROW_TIMELOCK_SWEEP_INTERVAL_MS=300000

# ── Dispute Auto-Resolution Sweeper (RFC-021 D8) ────────────────────────────
# Returns expired AUTO_PROPOSED recommendations to human review once the
# contest window closes. QVAC is advisory-only: this sweeper never applies
# a recommendation as settlement authority. Only meaningful when
# QVAC_AUTO_RESOLUTION_ENABLED is also true.
DISPUTE_AUTO_RESOLUTION_SWEEPER=false
DISPUTE_AUTO_RESOLUTION_SWEEP_INTERVAL_MS=300000

# Gates common/events/handlers.ts's automatic reaction to
# openp2p.trade.created -> settlement-orchestrator.ts's executeSettlement()
# (creates escrow, locks funds, emulates PIX receipt, releases real signed
# USDT once WDK_SEED_PHRASE is configured). Default false: this event
# fires for every real trade in this codebase, not only agent-driven demo
# trades, so unconditional auto-release would silently bypass the
# negotiation/dispute-window design. Leave false unless you specifically
# want fully autonomous settlement on every match.
AUTO_SETTLE_ON_MATCH=false

# ── Capability Authority (RFC-013/014, ADR-004, Issue #303) ────────────────
# PRODUCTION REQUIRES ENFORCE_CAPABILITIES=true - a NODE_ENV=production
# process refuses to boot with it unset, false, or any other value.
# Development, test and reference environments may keep it false (no
# grants needed; this is what every demo/test runs with by default).
# When true, the gates are: intentEngine.create() and intent propose
# ('trade-coordination'), and release/refund/split admission + execution
# commit ('settlement'). Participants obtain the canonical grants with the
# SDK's capabilities.ensureCanonicalGrants() (self-issued consent, NOT
# independent third-party authorization) - the reference UI does this on
# every login; arbiters and sellers need the 'settlement' grant too.
# See docs/adr/ADR-004-capability-grant-temporal-authority.md.
ENFORCE_CAPABILITIES=false

# ── Two-Person Control for Escrow Release (RFC-015) ─────────────────────────
# Application-layer maker-checker, NOT on-chain multisig (one WDK seed
# still signs the eventual transfer regardless — see
# wdk-settlement.provider.ts's own custody-model caveat). When true, the
# normal (non-disputed) release path requires both of a trade's own two
# counterparties to call POST /v1/settlement/escrow/:id/approve-release
# first. Default false: turning this on changes the required calling
# pattern (the atomic executeSettlement() convenience call will start
# failing at its release step, by design — no approval can exist yet
# within that same synchronous call). `npm run demo:qvac` does NOT turn
# this on — see examples/demo/pix-to-usdt-flow.ts's own note on why, and
# tests/escrowReleaseControls.test.ts for the real, exercised mechanism.
REQUIRE_DUAL_APPROVAL_RELEASE=false

# ── OpenSettlement — Dispute Arbitration (RFC-007 D4) ──────────────────────
# Comma-separated participantIds this deployment trusts to arbitrate
# disputes. Empty means the dispute-resolution routes are unavailable
# until this is set — a reference deployment with no disputes yet is a
# valid state, not a boot failure.
TRUSTED_ARBITRATORS=

# ── OpenSettlement — Arbitration Mode (RFC-021 D2) ──────────────────────────
# 'trusted-list' (default) preserves RFC-007 D4's original behavior above
# exactly — arbiters come only from TRUSTED_ARBITRATORS. 'market' opts
# into RFC-021's permissionless, collateral-and-reputation-weighted
# registry (MarketArbitrationProvider) — arbiters register themselves via
# POST /v1/settlement/arbitration/register, no TRUSTED_ARBITRATORS needed.
ARBITRATION_MODE=trusted-list

# ── OpenSettlement — QVAC-assisted auto-resolution (RFC-021 D8) ────────────
# Off by default in the codebase (every dispute goes straight to its
# assigned human arbiter until explicitly turned on) — turned ON here
# for this reference deployment (2026-08-09, project-owner decision) to
# actually demonstrate it. Payment-method-agnostic (not PIX-specific,
# not rail-specific). Still never final without a human contest window:
# a recommendation only applies once QVAC_AUTO_RESOLUTION_WINDOW_HOURS
# remains advisory; expiry returns the dispute to its assigned human arbiter
# and never executes the recommendation automatically.
QVAC_AUTO_RESOLUTION_ENABLED=true
QVAC_AUTO_RESOLUTION_CONFIDENCE_THRESHOLD=0.85
QVAC_AUTO_RESOLUTION_WINDOW_HOURS=24

# ── OpenSettlement — Protocol Fee (RFC-021 Phase 0, PROTOCOL_ECONOMY.md §3/§6.2) ──
# Decimal fraction (0.001 = 0.1%), charged only on a completed release,
# never a refund. Empty/0 matches the documented bootstrap-phase
# "Protocol Fee is OFF (0%)" default — the same activation range
# PROTOCOL_ECONOMY.md §3 names is 0.05%-0.15% (e.g. 0.0005-0.0015).
PROTOCOL_FEE_RATE=0

# ── OpenSettlement — Protocol Fee collection (Missão 11, FeePolicyVersion) ──
# A plain BTC destination address for the NEW, policy-versioned collection
# mechanism — unrelated to PROTOCOL_FEE_RATE above (the OLD, still-untouched
# accounting-only mechanism). Never a seed or private key. Empty by default:
# no real Sails treasury address has been chosen — a deployment cannot
# construct a fee-collecting MULTISIG transaction at all until this is set.
SAILS_PROTOCOL_FEE_COLLECTION_ADDRESS=

# ── OpenSettlement — WDK_USDT_EVM provider (wdk-settlement.provider.ts) ────
# Real @tetherto/wdk-wallet-evm calls. TESTNET ONLY — never point this at
# a mainnet RPC or a real USDT contract; MOCK_ESCROW=true (above) already
# keeps this provider inert by default even if these are set. A BIP-39
# seed phrase controls the treasury account AND every per-trade escrow
# sub-account (single-seed, two-hop escrow — see that file's own doc
# comment for the honest custody-model caveat). RFC-019: this is a
# SERVER-CUSTODIAL REFERENCE IMPLEMENTATION, not the protocol's
# normative custody model — never treat it as production-safe custody.
# See CRYPTOGRAPHIC_MODEL.md §5. Leave WDK_SEED_PHRASE empty to keep
# this provider disabled.
WDK_SEED_PHRASE=
WDK_RPC_URL=https://sepolia.drpc.org
WDK_USDT_CONTRACT=
# Bounded Remediation (WDK Fund-Moving Safety, 2026-09-08) —
# wdk-execution-truth.ts's bounded post-broadcast receipt-confirmation
# wait (attempts * intervalMs = ~30s by default). Not a confirmation-DEPTH
# guarantee (1 confirmation, not N) — see that file's own header comment.
WDK_RECEIPT_POLL_ATTEMPTS=10
WDK_RECEIPT_POLL_INTERVAL_MS=3000

# ── OpenSettlement — MULTISIG provider (multisig.provider.ts) ──────────────
# Real 2-of-3 Bitcoin P2WSH script/PSBT construction (bitcoinjs-lib).
# Buyer/seller keys are CLIENT-HELD (Phase 2, 2026-07-27) — only the
# arbiter's key is derived from MULTISIG_SEED here, so this is a genuine
# non-custodial 2-of-3 for the two counterparties, not the single-seed
# custody WDK_USDT_EVM above has. Real, disclosed limitations that don't
# go away just because mainnet is enabled: exactly one arbiter key is
# baked into each escrow's script at creation time (multisig.provider.ts's
# own "single-arbiter limitation" comment — requires exactly one
# TRUSTED_ARBITRATORS entry), the release/refund fee is now a real
# mempool.space rate lookup (2026-08-02, no more flat placeholder), and
# this reference implementation has not had an external security audit.
# Corrected 2026-08-02: this was previously documented here as
# "TESTNET ONLY" — that was a documentation default, not a code-enforced
# restriction (multisig.provider.ts's networkFor() has always accepted
# 'bitcoin'/'mainnet'); left uncorrected long enough that it was actively
# misleading once mainnet use was actually intended. Set MULTISIG_NETWORK
# to 'testnet' for any deployment that hasn't deliberately chosen real
# Bitcoin. Leave MULTISIG_SEED empty to keep this provider disabled.
MULTISIG_SEED=
MULTISIG_NETWORK=testnet
MULTISIG_EXPLORER_API_URL=https://mempool.space/testnet/api
# Mainnet equivalents, for a deployment that has deliberately chosen real
# BTC (see docs/DEPLOYMENT.md's own production checklist before using
# these): MULTISIG_NETWORK=bitcoin, MULTISIG_EXPLORER_API_URL=https://mempool.space/api

# ── OpenSettlement — SAFE_GUARD_EVM provider (safe-guard-evm.provider.ts) ──
# RFC-020: a Safe Transaction Guard + ERC-4337 escrow. Buyer/seller keys
# are client-held (same EscrowParticipantKey mechanism as MULTISIG); the
# one server-held key is the arbiter co-signer, and it lives in AWS KMS —
# this process never holds raw key material for it. TESTNET ONLY.
# Without a real AWS_KMS_KEY_ID configured, EVERY SAFE_GUARD_EVM escrow is
# inert, not just the disputed path (2026-08-01 change): the Safe's 3-owner
# list (buyer, seller, arbiter) is fixed at deployment regardless of dispute
# status, so deriving a Safe/Guard address at all needs the arbiter's own
# address (a read-only KMS GetPublicKeyCommand). Co-SIGNING (KMS Sign) is
# still only ever needed on the disputed path — the cooperative
# (buyer+seller) release/refund path needs no AWS Sign access.
# See RFC-020's own header comment and CRYPTOGRAPHIC_MODEL.md §5.1.
SAFE_GUARD_EVM_CHAIN_ID=11155111
SAFE_GUARD_EVM_ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1
# lockFunds()/verifyLock()/broadcast() (2026-08-01 pass) — real RPC/bundler
# calls, no live-money exercise. safe/module addresses below are canonical
# Safe v1.4.1 + Safe4337Module v0.3.0 deployments, verified live against
# Sepolia (eth_getCode) before being defaulted here — safe to leave as-is
# on Sepolia, override only for a different chain/version.
SAFE_GUARD_EVM_RPC_URL=https://sepolia.drpc.org
SAFE_GUARD_EVM_BUNDLER_URL=
SAFE_GUARD_EVM_PROXY_FACTORY=0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67
SAFE_GUARD_EVM_SINGLETON=0x29fcB43b46531BcA003ddC8FCB67FFE91900C762
SAFE_GUARD_EVM_4337_MODULE=0x75cf11467937ce3F2f357CE24ffc3DBF8fD5c226
SAFE_GUARD_EVM_MODULE_SETUP=0x2dd68b007B46fBe91B9A7c3EDa5A7a1063cB5b47
SAFE_GUARD_EVM_MULTISEND_CALL_ONLY=0x9641d764fc13c8B624c04430C7356C1C7C8102e2
SAFE_GUARD_EVM_DETERMINISTIC_DEPLOYER=0x4e59b44847b379578588920ca78fbf26c0b4956c

# ── OpenAgents — QVAC agent provider (qvac-agent.provider.ts) ──────────────
# No config needed — @qvac/sdk runs a local LLM (llama.cpp, GPU-accelerated
# via Vulkan/Metal) with no API key or cloud dependency. First call
# downloads the model (~737MB, cached locally after). Requires a GPU with
# a working Vulkan (Windows/Linux) or Metal (macOS) driver — see
# https://docs.qvac.tether.io/installation for platform requirements.

# ── OpenAgents — Social Engineering Agent (RFC-007 D7, real as of RFC-017) ──
# Off by default in the codebase (a real local-LLM call on every chat
# message is real latency/cost a reference deployment shouldn't pay for
# unconditionally) — turned ON here for this reference deployment
# (2026-08-09, project-owner decision) to actually demonstrate it. Runs
# entirely on-device (no message content leaves the process); detects,
# never acts — a positive signal only ever produces a chat RISK_WARNING,
# never blocks a message or a trade action.
SOCIAL_ENGINEERING_DETECTION=true

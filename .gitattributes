# Shell scripts run inside Linux containers (docker compose `migrate`,
# scripts/docker-test.sh). A Windows checkout with core.autocrlf=true wrote
# them as CRLF, and the image's /bin/sh then failed with
# "set: Illegal option -" — the Docker stack could not be brought up from
# Windows at all. Always check them out with LF.
*.sh text eol=lf
# the self-hosting kit is read by Linux tools (an extensionless shell script, a compose file, an env file whose
# values would otherwise carry a trailing CR): always LF
deploy/self-host/* text eol=lf
